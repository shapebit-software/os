// Settings' Check now: whoever is signed in at the machine may start a check
// for a system update, without a password; it only downloads, never restarts.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "os-update@now.service" &&
      action.lookup("verb") == "start" &&
      subject.local && subject.active) {
    return polkit.Result.YES;
  }
});
