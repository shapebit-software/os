#!/usr/bin/env bash

set -euo pipefail

readonly DEFAULT_AGENTS_URL="git@github.com:shapebit-software/agents.git"
readonly SHARED_PATH=".agents/shared"
readonly SKILLS_PATH=".agents/skills"
readonly CLAUDE_SKILLS_PATH=".claude/skills"

agents_url="${SHAPEBIT_AGENTS_URL:-$DEFAULT_AGENTS_URL}"

usage() {
    cat <<'EOF'
Usage: shapebit-agents <command> [skill...]

Manage shared ShapeBit skills in the current Git repository.

Commands:
  init              Create the shared submodule and Codex/Claude structure
  list              List shared skills and their local status
  add <skill...>    Enable one or more shared skills
  remove <skill...> Disable one or more shared skills
  update            Update the shared submodule to its remote main branch
  help              Show this help

Environment:
  SHAPEBIT_AGENTS_URL  Override the shared repository URL
EOF
}

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

note() {
    printf '%s\n' "$*"
}

repository_root() {
    git rev-parse --show-toplevel 2>/dev/null ||
        fail "run this command inside a Git repository"
}

set_paths() {
    root="$(repository_root)"
    shared_dir="$root/$SHARED_PATH"
    skills_dir="$root/$SKILLS_PATH"
    claude_skills="$root/$CLAUDE_SKILLS_PATH"
}

validate_skill_name() {
    case "$1" in
        '' | *[!A-Za-z0-9._-]*)
            fail "invalid skill name: $1"
            ;;
    esac
}

require_shared_repository() {
    if ! git -C "$shared_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        fail "shared skills are not initialized; run 'shapebit-agents init'"
    fi
}

has_shared_submodule_config() {
    [ -f "$root/.gitmodules" ] &&
        git -C "$root" config --file .gitmodules --get-regexp \
            '^submodule\..*\.path$' 2>/dev/null |
            awk -v path="$SHARED_PATH" '$2 == path { found = 1 } END { exit !found }'
}

ensure_claude_skills_link() {
    local expected='../.agents/skills'

    mkdir -p "$root/.claude"

    if [ -L "$claude_skills" ]; then
        [ "$(readlink "$claude_skills")" = "$expected" ] ||
            fail "$CLAUDE_SKILLS_PATH points somewhere else"
    elif [ -e "$claude_skills" ]; then
        fail "$CLAUDE_SKILLS_PATH already exists and is not the managed symlink"
    else
        ln -s "$expected" "$claude_skills"
        note "Created $CLAUDE_SKILLS_PATH -> $expected"
    fi
}

ensure_claude_instructions() {
    local claude_file="$root/CLAUDE.md"

    if [ ! -e "$root/AGENTS.md" ]; then
        note "Warning: AGENTS.md does not exist; add repository instructions there."
    fi

    if [ ! -e "$claude_file" ]; then
        printf '@AGENTS.md\n' >"$claude_file"
        note "Created CLAUDE.md with an AGENTS.md import"
    elif ! grep -Fxq '@AGENTS.md' "$claude_file"; then
        printf '\n@AGENTS.md\n' >>"$claude_file"
        note "Added the AGENTS.md import to CLAUDE.md"
    fi
}

command_init() {
    set_paths

    if ! mkdir -p "$root/.agents" "$skills_dir"; then
        fail "cannot write .agents; run the command outside a read-only agent sandbox"
    fi
    touch "$skills_dir/.gitkeep"

    if git -C "$shared_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        note "Shared repository already present at $SHARED_PATH"
    elif has_shared_submodule_config; then
        git -C "$root" submodule update --init --recursive -- "$SHARED_PATH"
        note "Initialized $SHARED_PATH"
    elif [ -e "$shared_dir" ]; then
        fail "$SHARED_PATH exists but is not the configured shared submodule"
    else
        git -C "$root" submodule add "$agents_url" "$SHARED_PATH"
        note "Added $SHARED_PATH"
    fi

    ensure_claude_skills_link
    ensure_claude_instructions
    note "ShapeBit agent structure is ready."
}

skill_status() {
    local skill="$1"
    local destination="$skills_dir/$skill"
    local expected="../shared/skills/$skill"

    if [ -L "$destination" ]; then
        if [ "$(readlink "$destination")" = "$expected" ]; then
            printf 'enabled'
        else
            printf 'conflict'
        fi
    elif [ -e "$destination" ]; then
        printf 'local'
    else
        printf 'disabled'
    fi
}

command_list() {
    local found=0
    local skill_dir skill

    set_paths
    require_shared_repository

    printf '%-32s %s\n' 'SKILL' 'STATUS'
    for skill_dir in "$shared_dir"/skills/*; do
        [ -f "$skill_dir/SKILL.md" ] || continue
        found=1
        skill="$(basename "$skill_dir")"
        printf '%-32s %s\n' "$skill" "$(skill_status "$skill")"
    done

    if [ "$found" -eq 0 ]; then
        note "No shared skills are available."
    fi
}

command_add() {
    local skill destination expected

    [ "$#" -gt 0 ] || fail "add requires at least one skill name"
    set_paths
    require_shared_repository
    mkdir -p "$skills_dir"

    # Validate the whole request before changing anything.
    for skill in "$@"; do
        validate_skill_name "$skill"
        [ -f "$shared_dir/skills/$skill/SKILL.md" ] ||
            fail "shared skill does not exist: $skill"

        destination="$skills_dir/$skill"
        expected="../shared/skills/$skill"

        if [ -L "$destination" ] && [ "$(readlink "$destination")" = "$expected" ]; then
            continue
        elif [ -e "$destination" ] || [ -L "$destination" ]; then
            fail "$SKILLS_PATH/$skill already exists and is not the managed shared skill"
        fi
    done

    for skill in "$@"; do
        destination="$skills_dir/$skill"
        expected="../shared/skills/$skill"
        if [ -L "$destination" ]; then
            note "$skill is already enabled"
        else
            ln -s "$expected" "$destination"
            note "Enabled $skill"
        fi
    done
}

command_remove() {
    local skill destination expected

    [ "$#" -gt 0 ] || fail "remove requires at least one skill name"
    set_paths
    require_shared_repository

    # Validate the whole request before changing anything.
    for skill in "$@"; do
        validate_skill_name "$skill"
        destination="$skills_dir/$skill"
        expected="../shared/skills/$skill"

        if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
            continue
        elif [ ! -L "$destination" ] || [ "$(readlink "$destination")" != "$expected" ]; then
            fail "refusing to remove non-managed skill: $SKILLS_PATH/$skill"
        fi
    done

    for skill in "$@"; do
        destination="$skills_dir/$skill"
        if [ -L "$destination" ]; then
            rm -- "$destination"
            note "Disabled $skill"
        else
            note "$skill is already disabled"
        fi
    done
}

command_update() {
    set_paths
    require_shared_repository
    git -C "$root" submodule update --remote -- "$SHARED_PATH"
    note "Updated $SHARED_PATH. Review and commit the new submodule pointer."
}

command="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command" in
    init) command_init "$@" ;;
    list) command_list "$@" ;;
    add) command_add "$@" ;;
    remove) command_remove "$@" ;;
    update) command_update "$@" ;;
    help | --help | -h) usage ;;
    *)
        usage >&2
        fail "unknown command: $command"
        ;;
esac
