#!/usr/bin/python3
# Dictation: hears what the person says (dictation/hear) and puts it into the text
# field that has the focus, but only if the same field still has it when the text
# is ready, so that it never lands somewhere the person did not mean. Run for one
# dictation, it talks over its standard input and output, one JSON line at a time.
#
# It is the Wayland input method for as long as it runs, for two things that
# nothing else offers: applications tell an input method when a text field has
# the focus and what kind it is, and text committed to a field cannot press
# shortcuts, as typed keys can. Password fields never get the text. Should another
# input method be running, it does without, and inserts nothing.
#
# Usage: dictate [--copy | --only-copy]
# --copy also copies the text, so that it is never lost: the bar's dictation does,
# while dictation for an application's own field only inserts. --only-copy never
# inserts. Without either, text with no field to go to is only in "done".
#
# While the person speaks, the words so far show in the field that has the focus,
# as a draft that is not yet in it (an input method's preedit), where the field
# allows it and the words may go there; otherwise only the shell shows them.
#
# From the shell, {"do": ...}: "stop"; "discard", which ends it. The end
# of the input discards, as do SIGINT and SIGTERM.
#
# To the shell: hear's "listening" and "writing", as it says them; its "draft",
# with "inline": true while the field shows it; and
# at the end, {"state": "done", "text": ..., "inserted": bool, "copied": bool,
# "app": ...}; {"state": "nothing"}; or {"state": "failed"}.
import json
import os
import pathlib
import selectors
import signal
import socket
import struct
import subprocess
import sys

HEAR = os.environ.get("DICTATION_HEAR", str(pathlib.Path(__file__).with_name("hear")))

# zwp_text_input_v3's purposes and hints that mean a secret.
PURPOSE_PASSWORD, PURPOSE_PIN = 8, 9
HINT_SENSITIVE = 0x40
# No space goes between these, before the cursor, and the text.
NO_SPACE_AFTER = "([{\"'«„“‘/-"

REGISTRY, SEAT, MANAGER, METHOD = 2, 3, 4, 5


def string(text):
    data = text.encode() + b"\0"
    return struct.pack("<I", len(data)) + data + b"\0" * (-len(data) % 4)


def read_string(data, offset):
    size = struct.unpack_from("<I", data, offset)[0]
    return data[offset + 4 : offset + 3 + size], offset + 4 + (size + 3 & ~3)


class InputMethod:
    """zwp_input_method_v2, as much as this needs: it is small and has no fds,
    and no Python binding ships this protocol."""

    def __init__(self):
        self.socket = None
        self.buffer = b""
        self.found = {}
        self.available = False
        self.commits = 0
        # A field's focus, counted, so that another one, or the same one again,
        # is seen as a move.
        self.activations = 0
        self.active = False
        self.purpose = self.hint = 0
        self.before = ""
        self.pending = {}
        display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        try:
            self.socket = socket.socket(socket.AF_UNIX)
            self.socket.connect(os.path.join(os.environ["XDG_RUNTIME_DIR"], display))
        except OSError:
            self.socket = None
            return
        self.send(1, 1, struct.pack("<I", REGISTRY))

    def send(self, target, opcode, payload=b""):
        self.socket.sendall(struct.pack("<IHH", target, opcode, 8 + len(payload)) + payload)

    def read(self):
        """False when the compositor has gone."""
        data = self.socket.recv(65536)
        if not data:
            self.available = self.active = False
            return False
        self.buffer += data
        while len(self.buffer) >= 8:
            target, word = struct.unpack_from("<II", self.buffer)
            opcode, size = word & 0xFFFF, word >> 16
            if len(self.buffer) < size:
                break
            payload, self.buffer = self.buffer[8:size], self.buffer[size:]
            if target == REGISTRY and opcode == 0:
                self.announced(payload)
            elif target == METHOD:
                self.event(opcode, payload)
        return True

    def announced(self, payload):
        name = struct.unpack_from("<I", payload)[0]
        interface = read_string(payload, 4)[0].decode()
        if interface in ("wl_seat", "zwp_input_method_manager_v2"):
            self.found[interface] = name
        if len(self.found) == 2 and not self.available:
            self.available = True
            for interface, number in (("wl_seat", SEAT), ("zwp_input_method_manager_v2", MANAGER)):
                self.send(REGISTRY, 0, struct.pack("<I", self.found[interface]) + string(interface) + struct.pack("<II", 1, number))
            self.send(MANAGER, 0, struct.pack("<II", SEAT, METHOD))

    def event(self, opcode, payload):
        if opcode == 0:  # activate
            self.pending = {"active": True, "purpose": 0, "hint": 0, "before": ""}
            self.activations += 1
        elif opcode == 1:  # deactivate
            self.pending["active"] = False
        elif opcode == 2:  # surrounding_text
            text, offset = read_string(payload, 0)
            cursor, anchor = struct.unpack_from("<II", payload, offset)
            # A selection is replaced, so what comes before it does not count.
            self.pending["before"] = text[:cursor].decode(errors="ignore")[-1:] if cursor == anchor else ""
        elif opcode == 4:  # content_type
            self.pending["hint"], self.pending["purpose"] = struct.unpack("<II", payload)
        elif opcode == 5:  # done
            self.commits += 1
            for name, value in self.pending.items():
                setattr(self, name, value)
            self.pending = {}
        elif opcode == 6:  # unavailable: another input method runs
            self.available = self.active = False

    @property
    def secret(self):
        return self.active and (self.purpose in (PURPOSE_PASSWORD, PURPOSE_PIN) or bool(self.hint & HINT_SENSITIVE))

    def spaced(self, text):
        """With the space the field needs before it."""
        last = self.before
        return " " + text if last and not last.isspace() and last not in NO_SPACE_AFTER else text

    def commit(self, text):
        """With the space it may need; it takes the place of the draft, as a commit
        with no draft of its own leaves none."""
        self.send(METHOD, 0, string(self.spaced(text)))
        self.send(METHOD, 3, struct.pack("<I", self.commits))

    def draft(self, text):
        """Shown in the field, where it would go, and not yet in it; "" takes it away."""
        text = self.spaced(text) if text else ""
        end = len(text.encode())
        self.send(METHOD, 1, string(text) + struct.pack("<ii", end, end))
        self.send(METHOD, 3, struct.pack("<I", self.commits))


def focused_window():
    """The focused window, as Hyprland tells; {} with none."""
    try:
        result = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2, check=True)
        return json.loads(result.stdout) or {}
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}


def clean(said):
    """One line of text, for a field or a terminal: no control characters pass."""
    said = "".join(c if c.isprintable() else " " for c in said)
    return " ".join(said.split())


class Dictation:
    def __init__(self, copy, only_copy):
        self.copy = copy or only_copy
        self.only_copy = only_copy
        self.selector = selectors.DefaultSelector()
        self.method = InputMethod()
        self.input = b""
        self.state = "listening"
        self.from_hearing = b""
        self.target = None
        # The draft: as hear said it, and the field that shows it, if one does.
        self.draft = None
        self.shown = None

        wake_read, wake_write = os.pipe()
        os.set_blocking(wake_write, False)
        signal.set_wakeup_fd(wake_write)
        for number in (signal.SIGINT, signal.SIGTERM):
            signal.signal(number, lambda *_: None)
        self.selector.register(wake_read, selectors.EVENT_READ, self.woken)
        self.selector.register(sys.stdin.fileno(), selectors.EVENT_READ, self.commanded)
        if self.method.socket:
            self.selector.register(self.method.socket, selectors.EVENT_READ, self.compositor)
        # What is under way ends with this, so the microphone never stays open.
        self.hearing = subprocess.Popen(
            ["setpriv", "--pdeathsig", "TERM", HEAR],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
        )
        self.selector.register(self.hearing.stdout, selectors.EVENT_READ, self.heard)

    def emit(self, **message):
        print(json.dumps(message, ensure_ascii=False), flush=True)

    def finish(self, code):
        self.hide_draft()
        if self.hearing.poll() is None:
            self.hearing.terminate()
        self.hearing.wait()
        sys.exit(code)

    # Commands ------------------------------------------------------------

    def woken(self, source):
        os.read(source, 64)
        self.finish(130)

    def commanded(self, source):
        data = os.read(source, 65536)
        if not data:
            self.finish(130)
        self.input += data
        *lines, self.input = self.input.split(b"\n")
        for line in lines:
            what = json.loads(line)["do"]
            if what == "discard":
                self.finish(130)
            elif what == "stop" and self.state == "listening":
                # Where the words were meant to go is where the focus was at the stop.
                self.target = self.place()
                self.to_hearing("stop")

    # Hearing -------------------------------------------------------------

    def to_hearing(self, what):
        try:
            self.hearing.stdin.write(json.dumps({"do": what}).encode() + b"\n")
            self.hearing.stdin.flush()
        except OSError:
            pass

    def heard(self, source):
        data = os.read(source.fileno(), 65536)
        if not data:
            # Ended with no words: it could not listen, or write them down.
            self.selector.unregister(source)
            if self.state in ("listening", "writing"):
                self.emit(state="failed")
                self.finish(1)
            return
        self.from_hearing += data
        *lines, self.from_hearing = self.from_hearing.split(b"\n")
        for line in lines:
            message = json.loads(line)
            state = message["state"]
            if state == "writing" and self.target is None:
                # It stopped by itself, after a long silence.
                self.target = self.place()
            if state == "draft":
                self.draft = message
                self.place_draft(changed=True)
            elif state in ("listening", "writing"):
                self.state = state
                self.emit(**message)
            elif state in ("done", "nothing"):
                self.written(clean(message.get("text", "")))

    # The draft -----------------------------------------------------------

    def place_draft(self, changed=False):
        """In the field that has the focus, if the words may go there; moved along
        with the focus, and gone from a field that may no longer get them."""
        if not self.draft:
            return
        method = self.method
        # After the stop, only the field that had the focus then may get them.
        may = (not self.only_copy and method.active and not method.secret
               and (self.state == "listening" or self.state == "writing" and method.activations == self.target[1]))
        field = method.activations if may else None
        if field == self.shown and not changed:
            return
        if field is not None:
            method.draft(" ".join(part for part in (self.draft["text"], self.draft["tail"]) if part))
        else:
            self.hide_draft()
        self.shown = field
        self.emit(**self.draft, inline=field is not None)

    def hide_draft(self):
        # A field that lost the focus has dropped it already.
        if self.shown is not None and self.method.active and self.method.activations == self.shown:
            self.method.draft("")
        self.shown = None

    # Delivering ----------------------------------------------------------

    def place(self):
        """The focused window and field, to tell if the person has moved."""
        return focused_window().get("address"), self.method.activations

    def written(self, text):
        if not text:
            self.emit(state="nothing")
            self.finish(0)
        app = focused_window().get("class", "")
        inserted = False
        if not self.only_copy and self.place() == self.target and self.method.active and not self.method.secret:
            # It takes the place of the draft.
            self.method.commit(text)
            self.shown = None
            inserted = True
        if self.copy:
            subprocess.run(["wl-copy"], input=text.encode(), check=False)
        self.emit(state="done", text=text, inserted=inserted, copied=self.copy, app=app)
        self.finish(0)

    # The loop ------------------------------------------------------------

    def compositor(self, source):
        if not self.method.read():
            self.selector.unregister(source)
            source.close()
            self.method.socket = None
        self.place_draft()

    def run(self):
        while True:
            for key, _ in self.selector.select():
                key.data(key.fileobj)


def main():
    arguments = sys.argv[1:]
    Dictation("--copy" in arguments, "--only-copy" in arguments).run()


if __name__ == "__main__":
    main()
