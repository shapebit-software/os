#!/usr/bin/python3
# Live speech recognition for dictation/hear, which runs this for one recording:
# 16 kHz mono 16-bit audio comes in on the standard input, and JSON lines go out.
# Silero finds where phrases end, and Parakeet writes each one down when it does. All
# the audio goes to Parakeet: Silero only says where to cut, as it can take a short
# phrase for silence, and those words would be lost. While a phrase goes on, Parakeet
# also goes over what there is so far, for a draft that is only ever shown. Nothing
# else in the image does this; sherpa-onnx runs both.
#
# Usage: dictate-engine MODELS (the folder of Parakeet's and Silero's files).
#
# Out: {"draft": ..., "tail": ...}, the phrase so far, the words that the last two
# passes agree on and those that may still change; {"final": ...}, a phrase.
# It ends when the input ends and the last phrase is out.
import json
import os
import queue
import sys
import threading
import time

THREADS = 2
RATE = 16000
WINDOW = 512
# A pause this long, in seconds, ends a phrase; and a phrase ends at this length, as
# going over a longer one takes too long on a small computer.
PAUSE = 0.5
LONGEST_PHRASE = 15
# Drafts come this often at most, in seconds, and leave Parakeet idle at least half
# of the time, so that the fan stays quiet on a long dictation.
DRAFT_EVERY = 1


def agreed(before, after):
    """How many words of after come first in before too, ignoring case and punctuation."""

    def key(word):
        return "".join(c for c in word.lower() if c.isalnum())

    count = 0
    for old, new in zip(before, after):
        if key(old) != key(new):
            break
        count += 1
    return count


def say(**message):
    print(json.dumps(message, ensure_ascii=False), flush=True)


def main():
    models = sys.argv[1]
    sys.path.insert(0, os.environ.get("DICTATION_PYTHON", "/usr/lib64/dictation"))
    import numpy
    import sherpa_onnx

    recognizer = sherpa_onnx.OfflineRecognizer.from_transducer(
        encoder=f"{models}/encoder.int8.onnx",
        decoder=f"{models}/decoder.int8.onnx",
        joiner=f"{models}/joiner.int8.onnx",
        tokens=f"{models}/tokens.txt",
        num_threads=THREADS,
        model_type="nemo_transducer",
    )
    config = sherpa_onnx.VadModelConfig()
    config.silero_vad.model = f"{models}/silero_vad_v5.onnx"
    config.silero_vad.min_silence_duration = PAUSE
    config.silero_vad.max_speech_duration = LONGEST_PHRASE
    config.silero_vad.window_size = WINDOW
    config.sample_rate = RATE
    config.num_threads = 1
    detector = sherpa_onnx.VoiceActivityDetector(config, buffer_size_in_seconds=LONGEST_PHRASE * 4)

    def write_down(samples):
        stream = recognizer.create_stream()
        stream.accept_waveform(RATE, samples)
        recognizer.decode_stream(stream)
        return stream.result.text.strip()

    # Read apart from the work, so that the helper can always write.
    incoming = queue.Queue()

    def read():
        while data := os.read(0, 8192):
            incoming.put(data)
        incoming.put(None)

    threading.Thread(target=read, daemon=True).start()

    pending = b""
    # The audio since the last cut, and where that cut was in the whole recording.
    heard = numpy.zeros(0, dtype=numpy.float32)
    cut = 0
    previous = []
    next_draft = 0
    ended = False

    def phrase(until):
        nonlocal heard, cut, previous, next_draft
        text = write_down(heard[:until])
        heard = heard[until:]
        cut += until
        previous = []
        next_draft = 0
        if text:
            say(final=text)

    def phrases():
        while not detector.empty():
            # In the middle of the pause, so that no word loses its end.
            end = detector.front.start + len(detector.front.samples) + int(PAUSE / 2 * RATE)
            detector.pop()
            phrase(min(end - cut, len(heard)))

    while not ended:
        chunks = [incoming.get()]
        # All that came during the last pass, so that a slow pass cannot leave it behind.
        while not incoming.empty():
            chunks.append(incoming.get())
        if chunks[-1] is None:
            ended = True
            chunks.pop()
        pending += b"".join(chunks)
        whole = len(pending) // (WINDOW * 2) * (WINDOW * 2)
        if whole:
            audio = numpy.frombuffer(pending[:whole], dtype=numpy.int16).astype(numpy.float32) / 32768
            pending = pending[whole:]
            heard = numpy.concatenate((heard, audio))
            for start in range(0, len(audio), WINDOW):
                detector.accept_waveform(audio[start : start + WINDOW])
        phrases()
        # A long time with no phrase may still hold something.
        if not detector.is_speech_detected() and len(heard) >= LONGEST_PHRASE * RATE:
            phrase(len(heard))
        if not ended and detector.is_speech_detected() and time.monotonic() >= next_draft:
            began = time.monotonic()
            words = write_down(heard).split()
            spent = time.monotonic() - began
            next_draft = began + max(DRAFT_EVERY, spent * 2)
            if words:
                count = agreed(previous, words)
                say(draft=" ".join(words[:count]), tail=" ".join(words[count:]))
            previous = words
    detector.flush()
    phrases()
    if len(heard):
        phrase(len(heard))


if __name__ == "__main__":
    main()
