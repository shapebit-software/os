#!/usr/bin/python3
# Live speech recognition for dictation/hear, for one recording at a time: 16 kHz
# mono 16-bit audio comes in, and JSON lines go out. Silero finds where phrases end,
# and Parakeet writes each one down when it does. All the audio goes to Parakeet:
# Silero only says where to cut, as it can take a short phrase for silence, and those
# words would be lost. Each phrase is written down once, when it ends: going over it
# again as it goes on, for a draft, would keep the computer busy while the person
# speaks and could hold up the phrase's end. Nothing else in the image does this;
# sherpa-onnx runs both.
#
# Usage:
#   dictate-engine [--recorded] MODELS            one recording, on the standard input
#   dictate-engine --serve MODELS                 speech-model.service: one recording
#                                                 per connection on the socket systemd
#                                                 passes, after a line of JSON,
#                                                 {"recorded": bool}
#   dictate-engine --connect SOCKET [--recorded]  one recording, on the standard input,
#                                                 through the service; for hear, as the
#                                                 first does
# MODELS is the folder of Parakeet's and Silero's files. --recorded is for a whole
# recording, once it is over, as dictation's at its stop: no phrase goes out as it
# comes; at the end, it is written down in pieces of up to 15 seconds, cut at its
# pauses, which Parakeet punctuates and spells better than the short phrases of
# live speech. One piece is no longer, as Parakeet drops words beyond 20 seconds.
#
# Loading Parakeet takes about two seconds and holds about 1.1 GB, so the service
# keeps it loaded between recordings: always, with Settings > Assistant's "Load the
# speech model" at "After sign-in", or else until it has been unused for the minutes
# chosen there; then it ends, and the socket starts it again with the next recording.
# It reads the setting as it waits, so a change counts at once. It ends by itself,
# as only it knows when it is unused.
#
# With the models comes Smart Turn (smart-turn.onnx), which hears from the voice
# whether the person is done, as a sentence ends rather than pauses, and needs
# Fedora's ONNX Runtime (packages). At each phrase's end, it judges the last 8
# seconds, half a second past the speech, where it is surest; without either, it
# does not judge, and hear goes by the words alone.
#
# Out: {"speech": true}, a phrase has begun; {"final": ..., "turn": 0..1}, a phrase,
# written down, with how likely the person is done, when Smart Turn judges.
# It ends when the input ends and the last phrase is out. Through the service, a
# last {"end": true} says the recording was written down to its end; --connect
# passes on all but that, and fails without it.
import json
import os
import pathlib
import queue
import select
import socket
import sys
import threading
import time

THREADS = 2
RATE = 16000
WINDOW = 512
# A pause this long, in seconds, ends a phrase; and a phrase ends at this length, as
# going over a longer one takes too long on a small computer.
PAUSE = 0.5
LONGEST_PHRASE = 15
# The service checks the setting this often, in seconds, as it waits.
# Smart Turn's features: Whisper's log-mel, of the last 8 s.
TURN_SECONDS = 8
N_FFT, HOP, MELS = 400, 160, 80
CHECK_EVERY = float(os.environ.get("DICTATION_CHECK_EVERY", 30))
SETTINGS = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config") / "desktop/settings.json"


def load(models):
    """Parakeet, and a way to make Silero, which keeps what it heard, for each recording."""
    sys.path.insert(0, os.environ.get("DICTATION_PYTHON", "/usr/lib64/dictation"))
    import sherpa_onnx

    recognizer = sherpa_onnx.OfflineRecognizer.from_transducer(
        encoder=f"{models}/encoder.int8.onnx",
        decoder=f"{models}/decoder.int8.onnx",
        joiner=f"{models}/joiner.int8.onnx",
        tokens=f"{models}/tokens.txt",
        num_threads=THREADS,
        model_type="nemo_transducer",
    )

    def detector():
        config = sherpa_onnx.VadModelConfig()
        config.silero_vad.model = f"{models}/silero_vad_v5.onnx"
        config.silero_vad.min_silence_duration = PAUSE
        config.silero_vad.max_speech_duration = LONGEST_PHRASE
        config.silero_vad.window_size = WINDOW
        config.sample_rate = RATE
        config.num_threads = 1
        return sherpa_onnx.VoiceActivityDetector(config, buffer_size_in_seconds=LONGEST_PHRASE * 4)

    return recognizer, detector, turn_judge(models)


def mel_filters():
    """Whisper's 80 mel filters over 0 to 8 kHz, Slaney's scale and areas, as
    transformers' WhisperFeatureExtractor makes them: (201, 80)."""
    import numpy

    def to_mel(hz):
        hz = numpy.asarray(hz, dtype=numpy.float64)
        return numpy.where(hz >= 1000, 15 + numpy.log(numpy.maximum(hz, 1e-10) / 1000) / (numpy.log(6.4) / 27), 3 * hz / 200)

    def to_hz(mel):
        mel = numpy.asarray(mel, dtype=numpy.float64)
        return numpy.where(mel >= 15, 1000 * numpy.exp((numpy.log(6.4) / 27) * (mel - 15)), 200 * mel / 3)

    bins = numpy.linspace(0, RATE // 2, N_FFT // 2 + 1)
    points = to_hz(numpy.linspace(to_mel(0), to_mel(RATE / 2), MELS + 2))
    widths = numpy.diff(points)
    slopes = points[None, :] - bins[:, None]
    filters = numpy.maximum(0, numpy.minimum(-slopes[:, :-2] / widths[:-1], slopes[:, 2:] / widths[1:]))
    return filters * (2 / (points[2 : MELS + 2] - points[:MELS]))[None, :]


def turn_features(samples, filters):
    """Smart Turn's input, as its own code makes it with WhisperFeatureExtractor
    (chunk_length=8, do_normalize=True): the last 8 s, zero-mean and of unit
    variance, silence after, as log-mel features, (1, 80, 800)."""
    import numpy

    samples = numpy.asarray(samples, dtype=numpy.float32)[-RATE * TURN_SECONDS :]
    audio = numpy.zeros(RATE * TURN_SECONDS, dtype=numpy.float32)
    audio[: len(samples)] = (samples - samples.mean()) / numpy.sqrt(samples.var() + 1e-7)
    padded = numpy.pad(audio, N_FFT // 2, mode="reflect")
    frames = numpy.lib.stride_tricks.sliding_window_view(padded, N_FFT)[::HOP]
    window = 0.5 - 0.5 * numpy.cos(2 * numpy.pi * numpy.arange(N_FFT) / N_FFT)
    mel = (numpy.abs(numpy.fft.rfft(frames * window, axis=1)) ** 2)[:-1] @ filters
    log = numpy.log10(numpy.maximum(mel, 1e-10))
    log = numpy.maximum(log, log.max() - 8)
    return ((log + 4) / 4).T[None].astype(numpy.float32)


def turn_judge(models):
    """How likely the person is done, from the audio so far, or None where Smart
    Turn or ONNX Runtime is not there."""
    path = pathlib.Path(models) / "smart-turn.onnx"
    if not path.is_file():
        return None
    try:
        import onnxruntime
    except ImportError:
        return None
    options = onnxruntime.SessionOptions()
    options.inter_op_num_threads = 1
    options.intra_op_num_threads = THREADS
    session = onnxruntime.InferenceSession(str(path), options, providers=["CPUExecutionProvider"])
    filters = mel_filters()
    return lambda samples: float(session.run(None, {"input_features": turn_features(samples, filters)})[0].reshape(-1)[0])


def recording(recognizer, detector, turn, source, say, gone=lambda: False, recorded=False):
    """Writes down one recording, read from the file descriptor source until it
    ends, and says what it heard with say(**message). Returns False, with the last
    phrase not written down, when the caller is gone()."""
    import numpy

    detector = detector()

    def write_down(samples):
        stream = recognizer.create_stream()
        stream.accept_waveform(RATE, samples)
        recognizer.decode_stream(stream)
        return stream.result.text.strip()

    # Read apart from the work, so that the helper can always write.
    incoming = queue.Queue()

    def read():
        try:
            while data := os.read(source, 8192):
                incoming.put(data)
        except OSError:
            pass
        incoming.put(None)

    threading.Thread(target=read, daemon=True).start()

    pending = b""
    # The audio since the last cut, and where that cut was in the whole recording.
    heard = numpy.zeros(0, dtype=numpy.float32)
    cut = 0
    # The last seconds, for Smart Turn, and how much came in all.
    recent = numpy.zeros(0, dtype=numpy.float32)
    total = 0
    speaking = False
    ended = False

    def phrase(until):
        nonlocal heard, cut
        text = write_down(heard[:until])
        heard = heard[until:]
        cut += until
        if not text:
            return
        if turn is None:
            say(final=text)
            return
        # Half a second past the speech: the cut is a quarter past it.
        end = min(total, cut + int(PAUSE / 2 * RATE))
        judged = recent[: max(0, len(recent) - (total - end))]
        if len(judged):
            say(final=text, turn=round(turn(judged), 3))
        else:
            say(final=text)

    # A recording's pauses, where its pieces may end.
    pauses = []

    def phrases():
        while not detector.empty():
            # In the middle of the pause, so that no word loses its end.
            end = detector.front.start + len(detector.front.samples) + int(PAUSE / 2 * RATE)
            detector.pop()
            if recorded:
                pauses.append(end)
            else:
                phrase(min(end - cut, len(heard)))

    def pieces():
        """The recording in pieces of up to LONGEST_PHRASE, each to its last pause
        within that, or cut there where it has none."""
        longest = LONGEST_PHRASE * RATE
        start = 0
        while start < len(heard):
            ends = [end for end in pauses if start < end <= min(start + longest, len(heard))]
            end = len(heard) if len(heard) - start <= longest else ends[-1] if ends else start + longest
            text = write_down(heard[start:end])
            if text:
                say(final=text)
            start = end

    while not ended:
        chunks = [incoming.get()]
        # All that came during the last pass, so that a slow pass cannot leave it behind.
        while not incoming.empty():
            chunks.append(incoming.get())
        if chunks[-1] is None:
            ended = True
            chunks.pop()
        pending += b"".join(chunks)
        whole = len(pending) // (WINDOW * 2) * (WINDOW * 2)
        if whole:
            audio = numpy.frombuffer(pending[:whole], dtype=numpy.int16).astype(numpy.float32) / 32768
            pending = pending[whole:]
            heard = numpy.concatenate((heard, audio))
            recent = numpy.concatenate((recent, audio))[-RATE * (TURN_SECONDS + 2) :]
            total += len(audio)
            for start in range(0, len(audio), WINDOW):
                detector.accept_waveform(audio[start : start + WINDOW])
        phrases()
        if recorded:
            continue
        # A long time with no phrase may still hold something.
        if not detector.is_speech_detected() and len(heard) >= LONGEST_PHRASE * RATE:
            phrase(len(heard))
        if detector.is_speech_detected() != speaking:
            speaking = not speaking
            if speaking:
                say(speech=True)
    # Discarded, rather than ended: nobody waits for the rest.
    if gone():
        return False
    detector.flush()
    phrases()
    if recorded:
        pieces()
    elif len(heard):
        phrase(len(heard))
    return True


def kept_for():
    """How long, in seconds, the service stays unused before it ends, as Settings
    says; None, for always."""
    try:
        settings = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        settings = {}
    if settings.get("speechModel") == "ready":
        return None
    minutes = settings.get("speechModelMinutes")
    return 60 * (minutes if isinstance(minutes, (int, float)) and minutes > 0 else 10)


def serve(models):
    if os.environ.get("LISTEN_FDS") != "1":
        sys.exit("dictate-engine --serve: needs the socket from systemd (speech-model.socket)")
    listener = socket.socket(fileno=3)
    recognizer, detector, turn = load(models)
    last = time.monotonic()
    while True:
        keep = kept_for()
        left = CHECK_EVERY if keep is None else keep - (time.monotonic() - last)
        if left <= 0:
            return
        listener.settimeout(min(left, CHECK_EVERY))
        try:
            connection, _ = listener.accept()
        except TimeoutError:
            continue
        with connection:
            connection.settimeout(None)

            def say(**message):
                connection.sendall((json.dumps(message, ensure_ascii=False) + "\n").encode())

            def gone():
                # Closed, rather than only done sending: POLLHUP.
                poller = select.poll()
                poller.register(connection, select.POLLHUP)
                return bool(poller.poll(0))

            try:
                # What the recording is, on a line of its own before it.
                header = b""
                while not header.endswith(b"\n") and len(header) < 256:
                    byte = connection.recv(1)
                    if not byte:
                        break
                    header += byte
                try:
                    recorded = json.loads(header).get("recorded") is True
                except ValueError:
                    continue
                if recording(recognizer, detector, turn, connection.fileno(), say, gone, recorded):
                    say(end=True)
            except OSError:
                # Gone while it was said: the next recording.
                pass
        last = time.monotonic()


def connect(path, recorded=False):
    """The recording on the standard input, through the service, and what it says
    on the standard output; fails unless it says it is done."""
    server = socket.socket(socket.AF_UNIX)
    try:
        server.connect(path)
        server.sendall(json.dumps({"recorded": recorded}).encode() + b"\n")
    except OSError:
        sys.exit(1)

    def send():
        try:
            while data := os.read(0, 65536):
                server.sendall(data)
            server.shutdown(socket.SHUT_WR)
        except OSError:
            pass

    threading.Thread(target=send, daemon=True).start()
    done = False
    try:
        for line in server.makefile("rb"):
            if json.loads(line).get("end"):
                done = True
                break
            sys.stdout.buffer.write(line)
            sys.stdout.flush()
    except OSError:
        pass
    sys.exit(0 if done else 1)


def main():
    if sys.argv[1] == "--serve":
        serve(sys.argv[2])
    elif sys.argv[1] == "--connect":
        connect(sys.argv[2], "--recorded" in sys.argv[3:])
    else:

        def say(**message):
            print(json.dumps(message, ensure_ascii=False), flush=True)

        recorded = sys.argv[1] == "--recorded"
        recognizer, detector, turn = load(sys.argv[-1])
        recording(recognizer, detector, turn, 0, say, recorded=recorded)


if __name__ == "__main__":
    main()
