# Updates the person's apps, Chrome included, from the remotes they came from,
# and removes the runtimes that no app uses any more: a job in the downloads
# queue (downloads/downloads), so that it never runs alongside an install,
# and Settings > Downloads shows it.
[Unit]
Description=Update apps
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/desktop/downloads add update install apps "App updates"
