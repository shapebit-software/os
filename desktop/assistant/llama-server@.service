# llama-server, with the model the extra %i downloaded, for as long as
# language-model@%i.service needs it. It listens before the model is loaded,
# and answers 503 until then, which the assistant waits out. The prompt
# cache needs one request at a time (--parallel 1); thinking is off, for
# answers in a second or two; the context is bounded, for its memory.
[Unit]
Description=Language model %i, running
StopWhenUnneeded=yes
ConditionPathExists=/var/lib/extras/%i/model.gguf

[Service]
ExecStartPre=-/usr/bin/rm -f %t/llama-server-%i.sock
ExecStart=/usr/libexec/llama/llama-server --model /var/lib/extras/%i/model.gguf --host %t/llama-server-%i.sock \
    --jinja --reasoning off --ctx-size 8192 --parallel 1 --no-webui
ExecStartPost=/bin/sh -c 'until [ -S "$1" ]; do sleep 0.2; done' sh %t/llama-server-%i.sock
TimeoutStartSec=60
# The desktop stays responsive while it works.
Nice=5
