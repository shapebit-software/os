# ShapeBit OS image. Run `make help` to list targets.
# Every variable below can be overridden, e.g. `make test OWNER_NAME=someone`.
# They configure the build; the tests' own settings, such as the first owner and
# the installer's locale, are in packages/testing/src/testing/machine.py.
#
# Every target runs in the development image (development/README.md),
# for developers and CI alike: on the host, make builds it, then runs itself in
# it. Only the host's container engine works outside it, through its socket.

# The host's container engine, which builds and runs every image: rootful
# Podman (`sudo podman`), or Docker. To change it everywhere, set it in the
# environment, such as `export ENGINE=docker` in the shell's profile; CI sets
# it in each workflow. In the development image, it is the client of the
# host's (development/dev.sh).
ENGINE         ?= sudo podman
FEDORA_VERSION ?= 45
# The images (image/Containerfile; image/README.md): the foundation that the OS
# and the development image start from; with FOUNDATION_CACHE, a published foundation that
# `make foundation` takes instead of building one, when it has the same recipe.
FOUNDATION       ?= localhost/shapebit-foundation:$(FEDORA_VERSION)
FOUNDATION_CACHE ?=
DEV_IMAGE      ?= localhost/shapebit-dev
IMAGE          ?= localhost/shapebit-os:dev
IMAGE_VERSION  ?= dev
# The commit that the image is made from, and its time, which is every time in
# ShapeBit's own packages (packages/packaging/src/package.macros).
IMAGE_REVISION ?= $(shell git rev-parse HEAD)
SOURCE_DATE_EPOCH ?= $(shell git log -1 --format=%ct)
BUILD          ?= build
IMAGE_ARCHIVE  ?= $(BUILD)/image.tar
# The installer medium: its image and its raw disk.
INSTALLER_IMAGE ?= localhost/shapebit-os-installer:dev
MEDIUM         ?= $(BUILD)/installer.img
MEDIUM_SIZE     ?= 7G
# The installer on the download site, which `make pull-installer` pulls (a
# private package: `skopeo login ghcr.io` first).
INSTALLER_REF   ?= ghcr.io/shapebit-software/os/installer:stable
KEYS_DIR       ?= $(BUILD)/keys
# The keys that sign the image, in KEYS_DIR: dev, or release, which are never
# generated by a build (make release-key; signing/README.md).
SIGNING_KEY    ?= dev
# What installed systems update from: the installer records it.
UPDATE_REF     ?= ghcr.io/shapebit-software/os:stable
# The local registry that `make publish` serves the image from, as
# DEV_UPDATE_REF, which a test machine reaches at the host's 10.0.2.2 (QEMU
# user networking); the update test switches the machine to it.
REGISTRY_PORT  ?= 5000
DEV_UPDATE_REF ?= 10.0.2.2:$(REGISTRY_PORT)/shapebit-os:dev
# The update test moves the installed machine to NEXT_ARCHIVE's build, then to
# NEXT2_ARCHIVE's, both newer, and back; `make update-builds` makes those of
# UPDATE_TAGS from IMAGE, as other versions (update-builds below).
# Candidate installs stable instead, and passes the candidate as NEXT_ARCHIVE,
# so it makes only next2.
UPDATE_TAGS    ?= next next2
NEXT_ARCHIVE   ?= $(BUILD)/image-next.tar
NEXT2_ARCHIVE  ?= $(BUILD)/image-next2.tar
# The order of the openQA modules (packages/testing/e2e/main.pm): install, everything
# from the medium; or update, which also updates the installed system to
# UPDATE_ARCHIVE's build before the desktop's modules.
FLOW           ?= install
UPDATE_ARCHIVE ?= $(IMAGE_ARCHIVE)
# The image, the medium, the disk, and the update test's builds are files,
# which make makes again only when what they are made from changed: the files
# of packages/ and image/, the settings that go into them, and the engine's
# images that they start from. SKIP names those that count as built, as they
# are, such as SKIP=image: what CI pulled instead of building. make's -o does
# not reach the development image.
SKIP           ?=
# External packages, which ShapeBit builds and publishes in its own repository
# (packages/repositories/README.md): the one that `make rpm` builds, and where.
RPM            ?= packages/dictation/external/sherpa-onnx
RPMS           ?= $(BUILD)/rpms
# The packages that lint, validate, the tests, sync, unsync, and watch work
# on: every one, or those named, as in PACKAGE="shell colors". CI names those
# that a change touches (packages/testing/src/testing/changed.py).
PACKAGE        ?=
# The kinds of this computer's USB devices that a VM in a window borrows,
# camera and bluetooth, found as they are plugged in; empty lends none
# (packages/testing/src/testing/machine.py, development/README.md#devices).
DEVICES        ?= camera

# The settings that cross into the development image when they are set in the
# environment, as in `OWNER_NAME=someone make disk` (development/dev.sh);
# those on make's command line cross in MAKEFLAGS. They are this file's own,
# set with ?= above (but ENGINE, which dev.sh sets there), the test settings
# of testing's machine.py, and those read elsewhere: test-system's IMAGE_DIGEST
# and GUEST, and the simulator's SCENARIO.
export DEV_ENV := $(filter-out ENGINE,$(shell sed -n 's/^\([A-Z][A-Z0-9_]*\) *?=.*/\1/p' Makefile)) \
  $(shell sed -n '/^SETTINGS = {/,/^}/s/^ *"\([A-Z][A-Z0-9_]*\)":.*/\1/p' packages/testing/src/testing/machine.py) \
  IMAGE_DIGEST GUEST SCENARIO
export ENGINE FEDORA_VERSION FOUNDATION FOUNDATION_CACHE DEV_IMAGE

# Checks that run here leave no bytecode in the tree.
export PYTHONDONTWRITEBYTECODE := 1

.DEFAULT_GOAL := help
.PHONY: help foundation dev-image dev clean FORCE

# A file that targets are made again after when it changes, made with FORCE
# every time: $1 takes the new content, $1.new, only when it differs.
FORCE:
replace = cmp -s $1.new $1 && rm $1.new || mv $1.new $1
# Writes $1, words, to $@, one per line: such as the settings of a build, and
# its files, so that a deleted file counts too.
record = $(shell mkdir -p $(@D))$(file >$@.new,$(subst $(eval) ,$(newline),$(strip $1)))@$(call replace,$@)
define newline


endef
# The engine's ID of image $1, or nothing without one, into $2.
engine-id = $(ENGINE) image inspect --format '{{.Id}}' $1 >$2.new 2>/dev/null || :; $(call replace,$2)
# A failed recipe leaves no output that would count as made.
.DELETE_ON_ERROR:

# The Fedora bootc image that FOUNDATION was built from, by digest: every build
# from the Containerfile takes it, and the OS's packaging check compares with it.
FOUNDATION_BASE = $$($(ENGINE) image inspect --format '{{index .Config.Labels "software.shapebit.foundation.base"}}' $(FOUNDATION))

help: ## List targets
	@awk -F ':.*## ' '/^[a-z-]+:.*## / { printf "  %-14s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

foundation: $(BUILD)/foundation.built ## Build the foundation image, which the OS and the development image start from

# The foundation and the development image are made again only when what they
# are made from changed (image/foundation.sh hashes the same), or the engine
# no longer has them as they were made: each .built file is touched after its
# .id, the engine's ID of the image. Candidate builds the foundation with
# FOUNDATION_FRESH=1: from Fedora's latest, without a cache, every time.
FOUNDATION_INPUTS := image/Containerfile image/foundation.sh image/requires.sh \
  $(wildcard packages/*/*.spec packages/repositories/system/*.repo packages/repositories/data/*.asc)
$(BUILD)/foundation.inputs: FORCE
	$(call record,FEDORA_VERSION=$(FEDORA_VERSION) FOUNDATION=$(FOUNDATION) FOUNDATION_CACHE=$(FOUNDATION_CACHE) \
	  $(FOUNDATION_INPUTS))
$(BUILD)/foundation.id: FORCE
	@$(call engine-id,$(FOUNDATION),$@)
$(BUILD)/foundation.built: $(BUILD)/foundation.inputs $(BUILD)/foundation.id $(FOUNDATION_INPUTS) \
  $(if $(FOUNDATION_FRESH),FORCE)
	image/foundation.sh $(if $(FOUNDATION_FRESH),--fresh)
	@$(call engine-id,$(FOUNDATION),$(BUILD)/foundation.id)
	touch $@

clean: ## Remove build outputs
	rm -rf $(BUILD)

ifndef IN_DEV_IMAGE
# On the host: the development image, then every other goal in it, all in one
# run of make there; the VMs' windows on the host session's display, and
# openQA with a network of its own, as isotovideo's VNC server listens on every
# address.
dev-image: $(BUILD)/dev-image.built ## Build the development image (image/Containerfile, its development stage)

# What the development image is made from: the foundation, the Containerfile,
# what the installer builds with, and what the tools run with.
DEV_INPUTS := image/Containerfile image/requires.sh packages/installer/installer.spec \
  $(foreach t,$(shell image/requires.sh --tools),packages/$t/$t.spec)
$(BUILD)/dev-image.inputs: FORCE
	$(call record,DEV_IMAGE=$(DEV_IMAGE) $(DEV_INPUTS))
$(BUILD)/dev-image.id: FORCE
	@$(call engine-id,$(DEV_IMAGE),$@)
# Without Docker's provenance attestation, as the foundation (image/foundation.sh).
$(BUILD)/dev-image.built: $(BUILD)/foundation.built $(BUILD)/dev-image.inputs $(BUILD)/dev-image.id $(DEV_INPUTS)
	BUILDX_NO_DEFAULT_ATTESTATIONS=1 $(ENGINE) build -t $(DEV_IMAGE) --target development \
	  --build-arg FOUNDATION=$(FOUNDATION) --build-arg BASE=$(FOUNDATION_BASE) \
	  -f image/Containerfile --build-context image=image packages
	@$(call engine-id,$(DEV_IMAGE),$(BUILD)/dev-image.id)
	touch $@

dev: dev-image ## Open a shell in the development image
	development/dev.sh bash

GOALS := $(filter-out help foundation dev-image dev clean,$(MAKECMDGOALS))
ifneq ($(GOALS),)
.PHONY: $(GOALS)
$(firstword $(GOALS)): dev-image
	$(if $(filter test-e2e,$(GOALS)),DEV_NETWORK=private) \
	  development/dev.sh $(if $(filter vm installer-vm simulate devices,$(GOALS)),--desktop) $(MAKE) $(GOALS)
$(wordlist 2,$(words $(GOALS)),$(GOALS)): $(firstword $(GOALS)) ; @:
endif

else
# In the development image.
export ENGINE FEDORA_VERSION FOUNDATION FOUNDATION_CACHE DEV_IMAGE $(DEV_ENV)
# The tests (packages/testing/README.md): in the tests/ of the code they test,
# of PACKAGE or every one; each level by its markers: none, a unit test
# (-m unit), integration, or a system_* one. Each run's results go in
# RESULTS/<time>-NAME.
PYTEST := python3 -m pytest --rootdir=.
TESTS := $(wildcard $(if $(PACKAGE),$(addsuffix /tests,$(SCOPE)),\
  packages/*/tests image/tests distribution/tests development/tests .github/tests))
junit = --junitxml=$(BUILD)/results/$(shell date -u +%Y%m%dT%H%M%SZ)-$1/junit.xml
# The installer's CTest tests labelled $1.
ctest = cmake -S packages/installer -B $(BUILD)/tests/installer -G Ninja && cmake --build $(BUILD)/tests/installer && \
  ctest --test-dir $(BUILD)/tests/installer -L $1 --output-on-failure
# The system tests, on the machine that --machine says; each file's marker
# says which machine it runs on.
SYSTEM := $(PYTEST) -p testing.system
# The machines that the system tests run on, which make vm and the others open too.
MACHINES := python3 packages/testing/src/testing/machine.py
# The prerequisites of a target, but those in SKIP; and $2, the files of
# target $1, unless $1 is in SKIP.
need = $(filter-out $(SKIP),$1)
unless-skipped = $(if $(filter $1,$(SKIP)),,$2)
# What the images and the medium are made from: the files of packages/ and
# image/, but those deleted and not yet committed.
INPUTS := $(wildcard $(shell git ls-files -co --exclude-standard packages image))
DISK_FILE = $(or $(DISK),$(BUILD)/disk.raw)
# PACKAGE's folders, or none for every package; and whether package $1 is in scope.
$(foreach p,$(PACKAGE),$(if $(wildcard packages/$p/$p.spec),,$(error PACKAGE=$p: no packages/$p/$p.spec)))
SCOPE := $(addprefix packages/,$(PACKAGE))
scoped = $(if $(PACKAGE),$(filter $1,$(PACKAGE)),$1)
# The features with Rust programs.
RUST := $(patsubst packages/%/Cargo.toml,%,$(wildcard packages/*/Cargo.toml))
KEYS := $(KEYS_DIR)/$(SIGNING_KEY)-secureboot.key $(KEYS_DIR)/$(SIGNING_KEY)-secureboot.crt \
        $(KEYS_DIR)/$(SIGNING_KEY)-pcr.key

.PHONY: image colors lint validate check test test-unit test-integration test-system test-system-image \
  test-system-installer test-system-update test-e2e publish installer rpm pull-installer \
  disk vm devices update-vm sync unsync watch simulate installer-vm ssh update-builds release-key

image: $(IMAGE_ARCHIVE) ## Build the container image with its signed UKI

$(BUILD)/image.inputs: FORCE
	$(call record,IMAGE=$(IMAGE) IMAGE_VERSION=$(IMAGE_VERSION) IMAGE_REVISION=$(IMAGE_REVISION) \
	  SOURCE_DATE_EPOCH=$(SOURCE_DATE_EPOCH) SIGNING_KEY=$(SIGNING_KEY) $(INPUTS))

# The engine's IMAGE, which the medium and the update test's builds start
# from: the archive is made again when it is gone or another build replaced
# it. The archive is touched last, as it is newer than the ID it records.
$(BUILD)/image.id: FORCE
	@$(call engine-id,$(IMAGE),$@)

$(IMAGE_ARCHIVE): $(KEYS) $(BUILD)/foundation.built $(BUILD)/image.inputs $(BUILD)/image.id $(INPUTS)
	image/seal.sh image/Containerfile $(IMAGE) $@ --target os \
	  --build-arg FOUNDATION=$(FOUNDATION) --build-arg BASE=$(FOUNDATION_BASE) \
	  --build-arg IMAGE_VERSION=$(IMAGE_VERSION) \
	  --build-arg IMAGE_REVISION=$(IMAGE_REVISION) --build-arg SOURCE_DATE_EPOCH=$(SOURCE_DATE_EPOCH)
	@$(call engine-id,$(IMAGE),$(BUILD)/image.id)
	touch $@

colors: ## Write the QML module Colors's values from the system's colors (packages/colors/data/colors.toml)
	python3 packages/colors/tools/colors.py

lint: ## Lint the shell, the Python, and the QML (of PACKAGE)
	$(if $(call scoped,shell),$(MAKE) -C packages/shell lint)
	packages/linting/src/lint.sh $(SCOPE)

# Every file has a license (REUSE.toml, with reuse lint).
validate: ## Validate the compositor configuration, the specs' Requires, and the licenses (of PACKAGE)
	$(if $(call scoped,windows),$(MAKE) -C packages/windows validate)
	reuse lint --quiet
	image/requires.sh --check
	packages/repositories/tools/check-licenses.sh $(SCOPE)

check: lint validate test ## Lint, validate, and test: all that needs no image (of PACKAGE)

test: test-unit test-integration ## Run the unit and integration tests (of PACKAGE)

test-unit: ## Run the unit tests: pytest's unmarked, the installer's, and Rust's (of PACKAGE)
	$(PYTEST) $(call junit,unit) -m unit $(TESTS) || test $$? = 5
	$(if $(call scoped,installer),$(call ctest,unit))
	$(foreach f,$(call scoped,$(RUST)),$(MAKE) -s -C packages/$f test CARGO_TARGET_DIR=$(abspath $(BUILD))/cargo/$f &&) true

test-integration: ## Run the integration tests: pytest's marked integration, and the installer's (of PACKAGE)
	$(PYTEST) $(call junit,integration) -m integration $(TESTS) || test $$? = 5
	$(if $(call scoped,installer),$(call ctest,integration))

# A container of the image, with nothing installed in it, which Testinfra
# reaches through the engine (packages/testing/src/testing/system.py).
test-system-image: $(call need,image) ## Build the image and run its system tests; nothing boots
	$(SYSTEM) -m system_image $(TESTS) --machine=container://$(IMAGE) --run=image

publish: $(call need,image) ## Push the image to the local update registry
	$(MACHINES) publish $(IMAGE_ARCHIVE)

installer: $(MEDIUM) ## Build the installer medium, which carries the image

$(BUILD)/medium.inputs: FORCE
	$(call record,INSTALLER_IMAGE=$(INSTALLER_IMAGE) MEDIUM_SIZE=$(MEDIUM_SIZE) UPDATE_REF=$(UPDATE_REF) \
	  IMAGE_REVISION=$(IMAGE_REVISION) SOURCE_DATE_EPOCH=$(SOURCE_DATE_EPOCH) SIGNING_KEY=$(SIGNING_KEY) $(INPUTS))

# The payload's build context holds only the image: the engine copies a context
# whole, and BUILD also holds disks and other builds. A hard link costs no space.
# The medium's record names IMAGE_REVISION, the tree's commit, whose installer it shows.
# The installer starts from OS alone, but the engine reads every FROM, and BASE
# has no default (image/Containerfile); the foundation may not be here, as in CI.
$(MEDIUM): $(call unless-skipped,image,$(IMAGE_ARCHIVE)) $(KEYS) $(BUILD)/medium.inputs $(INPUTS)
	mkdir -p $(BUILD)/payload
	ln -f $(IMAGE_ARCHIVE) $(BUILD)/payload/image.tar 2>/dev/null || cp $(IMAGE_ARCHIVE) $(BUILD)/payload/image.tar
	image/seal.sh image/Containerfile $(INSTALLER_IMAGE) $(BUILD)/installer.tar --target installer \
	  --build-arg OS=$(IMAGE) --build-arg BASE=scratch --build-arg UPDATE_REF=$(UPDATE_REF) --build-arg SOURCE_DATE_EPOCH=$(SOURCE_DATE_EPOCH) \
	  --build-context payload=$(BUILD)/payload
	packages/installer/tools/medium.sh
	image/archive.py medium $(IMAGE_ARCHIVE) $(MEDIUM) $(IMAGE_REVISION)

rpm: ## Build the external package RPM (a folder with a sources file), offline, into RPMS/NAME
	packages/repositories/tools/rpm-build.sh $(RPM) $(RPMS)/$(notdir $(RPM))

pull-installer: ## Pull an installer medium from GHCR instead of building it: INSTALLER_REF=...
	distribution/release.py pull-installer $(INSTALLER_REF) $(MEDIUM)

disk: $(DISK_FILE).json ## Install to a new disk: boot the medium in QEMU, check it, and install

# The installer's settings (machine.py).
$(BUILD)/disk.inputs: FORCE
	$(call record,DISK_SIZE=$(DISK_SIZE) OWNER_NAME=$(OWNER_NAME) OWNER_PASSWORD=$(OWNER_PASSWORD) \
	  RECOVERY_KEY=$(RECOVERY_KEY) LOCALE=$(LOCALE) KEYBOARD_LAYOUT=$(KEYBOARD_LAYOUT) TIME_ZONE=$(TIME_ZONE))

# The disk's record, which the install writes last. A disk that booted since,
# as in make vm, is newer than it, so make test installs again; the tests' clones leave it as it is.
# To install again anyway: rm $(DISK_FILE).json
$(DISK_FILE).json: $(call unless-skipped,installer,$(MEDIUM)) $(BUILD)/disk.inputs $(wildcard $(DISK_FILE))
	$(MACHINES) install

vm: ## Boot the installed disk in a window, with sound and USB devices (DEVICES); console here (Ctrl-A X quits)
	$(MACHINES) boot

devices: ## Lend the running VM the USB devices of DEVICES now, and take back the others
	$(MACHINES) devices

update-vm: $(call need,image) ## Update the running VM to this tree's image, as a system updates, and restart it
	$(MACHINES) update $(IMAGE_ARCHIVE)

sync: ## Lay this tree (PACKAGE) over the running VM's /usr, or this computer's with MACHINE=local, until it restarts
	python3 development/sync.py

unsync: ## Take make sync's changes (to PACKAGE) away again, without restarting the machine
	python3 development/sync.py --reset

watch: ## Sync as make sync does, at once and after every change to packages/ (PACKAGE)
	development/watch.sh $(SCOPE)

simulate: ## Run the tree's desktop in a window, on fake system services (SCENARIO=; development/simulator)
	python3 development/simulator/simulate.py

installer-vm: $(call need,installer) ## Boot the medium with a new disk in a window, to install by hand
	$(MACHINES) install --window

ssh: ## Open a root shell in the running machine
	$(MACHINES) ssh

# On a disposable clone of the installed disk; or with GUEST=ADDRESS, on a
# system that runs already, such as another computer (packages/testing/README.md).
test-system: $(if $(GUEST),,$(call need,test-system-image disk)) ## Install, then run the installed system's tests on a clone of it, or on GUEST=address
	$(SYSTEM) -m system_installed $(TESTS) $(if $(GUEST),--machine=ssh://$(GUEST) --run=$(GUEST),--machine=clone --run=installed)

test-system-installer: $(call need,installer) ## Boot the medium with a new disk and run its system tests, without installing
	$(MACHINES) check-installer

update-builds: $(UPDATE_TAGS:%=$(BUILD)/image-%.tar) ## Make the newer builds that the update test moves through (UPDATE_TAGS)

# The image under test as IMAGE's tag TAG, and version IMAGE_VERSION.TAG (image/update.Containerfile).
$(UPDATE_TAGS:%=$(BUILD)/image-%.tar): $(BUILD)/image-%.tar: $(call unless-skipped,image,$(IMAGE_ARCHIVE)) \
  image/update.Containerfile image/seal.sh $(KEYS)
	image/seal.sh image/update.Containerfile "$${IMAGE%:*}:$*" $@ \
	  --build-arg OS=$(IMAGE) --build-arg IMAGE_VERSION=$(IMAGE_VERSION).$*

# On the next build, the installed system's tests run too, between the
# update tests' own (system.py).
test-system-update: $(call need,disk update-builds) ## On a disposable clone: update to a new build, then roll back
	$(SYSTEM) -m 'system_installed or system_update' $(TESTS) --machine=clone --run=update \
	  --next=$(NEXT_ARCHIVE) --next2=$(NEXT2_ARCHIVE)

test-e2e: ## Run the end-to-end tests of the built medium itself, with openQA (FLOW=install|update)
	python3 packages/testing/e2e/run.py $(FLOW) $(if $(filter update,$(FLOW)),$(UPDATE_ARCHIVE))

release-key: ## Generate the missing release keys once, in KEYS_DIR outside build/; store them safely
	signing/keys.sh --release

# The signing keys.
$(KEYS) &:
	signing/keys.sh
endif
