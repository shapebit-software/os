# ShapeBit OS image. Run `make help` to list targets.
# Every variable below can be overridden, e.g. `make test ENGINE=docker`.

# Installing to a disk needs a root-capable engine: rootful Podman or Docker.
ENGINE         ?= sudo podman
IMAGE          ?= localhost/shapebit-os:dev
FEDORA_VERSION ?= 45
# The assistant's language model server, pinned: llama.cpp's release and its
# source's SHA-256.
LLAMA_VERSION          ?= 0.8.0
LLAMA_SHA256           ?= 51b1e025d7b12e83fa55736e65bc254acd9d23e49f546be7531368fef82210ee
IMAGE_VERSION  ?= dev
# The commit that the image is made from.
IMAGE_REVISION ?= $(shell git rev-parse HEAD)
BUILD          ?= build
IMAGE_ARCHIVE  ?= $(BUILD)/image.tar
DISK           ?= $(BUILD)/disk.raw
DISK_SIZE      ?= 20G
# The installer medium: its image, its source tree, and its raw disk.
INSTALLER_IMAGE ?= localhost/shapebit-os-installer:dev
INSTALLER_SRC   ?= installer
# The desktop's source tree, which the image installs.
DESKTOP_SRC     ?= desktop
MEDIUM          ?= $(BUILD)/installer.img
MEDIUM_SIZE     ?= 7G
# The installer on the download site, which `make pull-installer` pulls (a
# private package: `skopeo login ghcr.io` first).
INSTALLER_REF   ?= ghcr.io/shapebit-software/os/installer:stable
SSH_PORT       ?= 2222
SSH_KEY        ?= $(BUILD)/ssh/id_ed25519
# Disk images are raw, except the disposable clones that the tests make.
DISK_FORMAT    ?= raw
# Test results, and the tools that run the tests. Each disposable test machine
# has this SSH port, so that `make vm` can run beside it.
RESULTS        ?= $(BUILD)/results
VENV           ?= $(BUILD)/venv
TEST_DEPS      ?= tests/.deps
TEST_SSH_PORT  ?= 2223
# The engine of the full OS tests (openQA's isotovideo), built from tests/openqa.
OPENQA_IMAGE   ?= localhost/shapebit-openqa:dev
OPENQA_DISTRI  ?= tests/openqa
# openQA's target disk: sparse, and large enough that the installer leaves the
# whole reserve beside the home (docs/Design-Base.md), as on a real computer.
OPENQA_DISK_SIZE ?= 256G
# The first owner, an administrator that the installer creates.
OWNER_NAME     ?= dev
OWNER_PASSWORD ?= $(BUILD)/owner-password
RECOVERY_KEY   ?= $(BUILD)/recovery-key
# Settings of the installed system, as chosen in the installer. They differ
# from the image's defaults, so the tests show that the installer applied them.
LOCALE          ?= en_GB.UTF-8
KEYBOARD_LAYOUT ?= pl
TIME_ZONE       ?= Europe/Warsaw
KEYS_DIR       ?= $(BUILD)/keys
# The keys that sign the image, in KEYS_DIR: dev, or release, which are never
# generated by a build (make release-key). NAME-secureboot.key and .crt sign for
# Secure Boot; NAME-pcr.key signs the TPM2 PCR 11 policy.
SIGNING_KEY    ?= dev
BOOT_TIMEOUT   ?= 300
# What installed systems update from: the installer records it.
UPDATE_REF     ?= ghcr.io/shapebit-software/os:stable
# The local registry that `make publish` serves the image from, as
# DEV_UPDATE_REF, which the VM reaches at the host's 10.0.2.2 (QEMU user
# networking); the update test switches the VM to it.
REGISTRY_PORT  ?= 5000
DEV_UPDATE_REF ?= 10.0.2.2:$(REGISTRY_PORT)/shapebit-os:dev
# The update test moves the installed machine to NEXT_ARCHIVE's build, then to
# NEXT2_ARCHIVE's, both newer, and back; `make update-builds` builds those of
# UPDATE_TAGS. Candidate installs stable instead, and passes the candidate as
# NEXT_ARCHIVE, so it builds only next2.
UPDATE_TAGS    ?= next next2
NEXT_ARCHIVE   ?= $(BUILD)/image-next.tar
NEXT2_ARCHIVE  ?= $(BUILD)/image-next2.tar
# The order of the openQA modules (tests/openqa/main.pm): install, everything
# from the medium; or update, which also updates the installed system to
# UPDATE_ARCHIVE's build before the desktop's modules.
FLOW           ?= install
UPDATE_ARCHIVE ?= $(IMAGE_ARCHIVE)
# The copyleft source RPMs of the image, and of the installer
# (scripts/sources.py, docs/License.md). SOURCES_PREVIOUS names an earlier
# version's sources to compare with; SOURCES_CACHE, a directory of source RPMs
# to take instead of downloading them. Both are optional.
SOURCES_DIR           ?= $(BUILD)/sources
INSTALLER_SOURCES_DIR ?= $(BUILD)/installer-sources
INSTALLER_SOURCES     ?= $(BUILD)/installer-sources.tar
SOURCES_PREVIOUS      ?=
SOURCES_CACHE         ?=

export OPENQA_DISK_SIZE INSTALLER_REF IMAGE_REVISION IMAGE_ARCHIVE NEXT_ARCHIVE NEXT2_ARCHIVE FLOW UPDATE_ARCHIVE OPENQA_DISTRI OPENQA_IMAGE RESULTS VENV TEST_SSH_PORT DISK_FORMAT ENGINE IMAGE FEDORA_VERSION IMAGE_VERSION BUILD DISK DISK_SIZE INSTALLER_IMAGE MEDIUM MEDIUM_SIZE SSH_PORT SSH_KEY OWNER_NAME OWNER_PASSWORD RECOVERY_KEY LOCALE KEYBOARD_LAYOUT TIME_ZONE KEYS_DIR SIGNING_KEY BOOT_TIMEOUT REGISTRY_PORT UPDATE_REF DEV_UPDATE_REF

# Checks that run on this host leave no bytecode in the tree that tmt copies.
export PYTHONDONTWRITEBYTECODE := 1

.DEFAULT_GOAL := help
.PHONY: dev release-key help colors image static-checks lint validate test-unit test-image publish installer sources installer-sources pull-installer disk vm installer-vm ssh test test-plan update-builds test-update test-release test-guest clean

help: ## List targets
	@awk -F ':.*## ' '/^[a-z-]+:.*## / { printf "  %-12s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

KEYS := $(KEYS_DIR)/$(SIGNING_KEY)-secureboot.key $(KEYS_DIR)/$(SIGNING_KEY)-secureboot.crt \
        $(KEYS_DIR)/$(SIGNING_KEY)-pcr.key

dev: ## Enter the development container of the desktop and installer
	DBX_CONTAINER_MANAGER=docker distrobox enter shapebit-dev

image: $(KEYS) ## Build the container image with its signed UKI
	scripts/image.sh image/Containerfile $(IMAGE) $(IMAGE_ARCHIVE) \
	  --build-arg FEDORA_VERSION=$(FEDORA_VERSION) --build-arg IMAGE_VERSION=$(IMAGE_VERSION) \
	  --build-arg IMAGE_REVISION=$(IMAGE_REVISION) \
	  --build-arg LLAMA_VERSION=$(LLAMA_VERSION) --build-arg LLAMA_SHA256=$(LLAMA_SHA256) \
	  --build-context desktop=$(DESKTOP_SRC)

colors: ## Write the QML module Colors's values from the system's colors (image/rootfs/usr/share/colors/colors.toml)
	python3 scripts/colors.py

static-checks: lint validate ## Lint and validate, without building or running the code; in Fedora, as `make dev`

lint: $(VENV)/.done ## Lint the shell, the Python, the QML, and the test plans; in Fedora, as `make dev`
	scripts/static-checks.sh lint

validate: ## Validate the compositor configuration, the package list, and the units; in Fedora, as `make dev`
	scripts/static-checks.sh validate

test-unit: $(VENV)/.done ## Run the tests that need no image and no VM; in Fedora, as `make dev`
	scripts/test-unit.sh

test-image: image $(TEST_DEPS)/.done ## Build the image and test its files; nothing boots
	$(ENGINE) run --rm --network none -v "$(CURDIR)/tests:/tests:ro,z" $(IMAGE) /tests/pytest.sh /tests/image

publish: image ## Push the image to the local update registry
	scripts/publish.sh $(IMAGE_ARCHIVE)

# The payload's build context holds only the image: the engine copies a context
# whole, and BUILD also holds disks and other builds. A hard link costs no space.
installer: image ## Build the installer medium, which carries the image
	mkdir -p $(BUILD)/payload
	ln -f $(IMAGE_ARCHIVE) $(BUILD)/payload/image.tar 2>/dev/null || cp $(IMAGE_ARCHIVE) $(BUILD)/payload/image.tar
	scripts/image.sh image/Containerfile.installer $(INSTALLER_IMAGE) $(BUILD)/installer.tar \
	  --build-arg BASE=$(IMAGE) --build-arg UPDATE_REF=$(UPDATE_REF) \
	  --build-context installer=$(INSTALLER_SRC) --build-context payload=$(BUILD)/payload
	scripts/medium.sh

sources: image ## Collect the image's copyleft source RPMs into SOURCES_DIR
	scripts/sources.py collect $(IMAGE) $(SOURCES_DIR) \
	  $(if $(SOURCES_CACHE),--cache $(SOURCES_CACHE)) $(if $(SOURCES_PREVIOUS),--previous $(SOURCES_PREVIOUS))

installer-sources: installer ## Write the installer's sources as INSTALLER_SOURCES, and record them with the medium
	scripts/sources.py collect $(INSTALLER_IMAGE) $(INSTALLER_SOURCES_DIR) $(if $(SOURCES_CACHE),--cache $(SOURCES_CACHE))
	scripts/sources.py tar $(INSTALLER_SOURCES_DIR) $(INSTALLER_SOURCES)
	python3 scripts/provenance.py sources $(MEDIUM).json $(INSTALLER_SOURCES)

pull-installer: ## Pull an installer medium from GHCR instead of building it: INSTALLER_REF=...
	scripts/pull-installer.sh $(INSTALLER_REF)

disk: installer $(SSH_KEY) $(OWNER_PASSWORD) $(VENV)/.done $(TEST_DEPS)/.done ## Install to a new disk: boot the medium in QEMU and run the installer
	scripts/disk.sh

vm: $(SSH_KEY) ## Boot the installed disk in QEMU on this terminal (Ctrl-A X quits)
	scripts/vm.sh

installer-vm: installer $(SSH_KEY) ## Boot the medium with a new disk in a window, to install by hand
	scripts/disk.sh --window

ssh: $(SSH_KEY) ## Open a root shell in the running VM
	scripts/ssh.sh

test: test-image disk ## Install, then run tmt's checks on a disposable clone of the installed machine
	scripts/test-machine.sh system

test-plan: $(VENV)/.done $(TEST_DEPS)/.done ## Run one tmt plan on a clone of the disk as it is, without installing: PLAN=system
	scripts/test-machine.sh $(PLAN)

update-builds: $(KEYS) ## Build the newer images that the update test moves through (UPDATE_TAGS)
	set -e; for tag in $(UPDATE_TAGS); do \
	  $(MAKE) --no-print-directory image IMAGE="$${IMAGE%:*}:$$tag" \
	    IMAGE_VERSION=$(IMAGE_VERSION).$$tag IMAGE_ARCHIVE=$(BUILD)/image-$$tag.tar; \
	done

test-update: disk update-builds $(VENV)/.done $(TEST_DEPS)/.done ## On a disposable clone: update to a new build, then roll back
	scripts/publish.sh $(NEXT_ARCHIVE) next
	scripts/publish.sh $(NEXT2_ARCHIVE) next2
	scripts/test-machine.sh update

test-release: $(SSH_KEY) ## Full OS and UI tests of the built medium itself, with openQA (FLOW=install|update)
	scripts/openqa.sh

test-guest: $(VENV)/.done $(TEST_DEPS)/.done ## Run the system checks on another machine: GUEST=address IMAGE_DIGEST=sha256:...
	TEST_GUEST=$(GUEST) SSH_PORT=22 scripts/tmt.sh system $(RESULTS)/$(GUEST)-$$(date -u +%Y%m%dT%H%M%SZ)

release-key: ## Generate the release keys once, in KEYS_DIR outside build/; store them safely
	scripts/keys.sh --release

clean: ## Remove build outputs
	rm -rf $(BUILD)

# The tools that run the tests, on this host.
$(VENV)/.done: tests/requirements.txt tests/requirements-host.txt
	python3 -m venv $(VENV)
	$(VENV)/bin/pip install -q -r tests/requirements-host.txt
	touch $@

# What the checks need where they run. tmt carries it to the guest.
$(TEST_DEPS)/.done: tests/requirements.txt
	rm -rf $(TEST_DEPS)
	python3 -m pip install -q --target $(TEST_DEPS) -r tests/requirements.txt
	touch $@

$(SSH_KEY):
	mkdir -p $(@D)
	ssh-keygen -q -t ed25519 -N '' -C shapebit-dev -f $@

# Development-only password of the first owner.
$(OWNER_PASSWORD):
	mkdir -p $(@D)
	head -c 18 /dev/urandom | base64 | tr -d '\n' > $@

# The signing keys.
$(KEYS) &:
	scripts/keys.sh
