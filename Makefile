# ShapeBit OS image. Run `make help` to list targets.
# Every variable below can be overridden, e.g. `make test ENGINE=docker`. They
# configure the build; the tests' own settings, such as the first owner and
# the installer's locale, are in tests/machine.py.

# The container engine that builds and runs every image, on the host. It must
# be root-capable, rootful Podman or Docker, for the images' and the medium's
# privileged steps. To change it everywhere, set it in the environment, such as
# `export ENGINE=docker` in the shell's profile; CI sets it in each workflow.
ENGINE         ?= sudo podman
FEDORA_VERSION ?= 45
# The images (images/README.md): the foundation that the OS and the development
# image start from; with FOUNDATION_CACHE, a published foundation that
# `make foundation` takes instead of building one, when it has the same recipe.
FOUNDATION       ?= localhost/shapebit-foundation:$(FEDORA_VERSION)
FOUNDATION_CACHE ?=
IMAGE          ?= localhost/shapebit-os:dev
# On the host, dev, lint, validate, test-unit, run, and the machines and
# checks of the built OS run in the development image (images/development/dev.sh).
DEV_IMAGE      ?= localhost/shapebit-dev
IMAGE_VERSION  ?= dev
# The commit that the image is made from, and its time, which is every time in
# ShapeBit's own packages (packages/package.macros).
IMAGE_REVISION ?= $(shell git rev-parse HEAD)
SOURCE_DATE_EPOCH ?= $(shell git log -1 --format=%ct)
BUILD          ?= build
IMAGE_ARCHIVE  ?= $(BUILD)/image.tar
# The installer medium: its image and its raw disk.
INSTALLER_IMAGE ?= localhost/shapebit-os-installer:dev
MEDIUM         ?= $(BUILD)/installer.img
MEDIUM_SIZE     ?= 7G
# The installer on the download site, which `make pull-installer` pulls (a
# private package: `skopeo login ghcr.io` first).
INSTALLER_REF   ?= ghcr.io/shapebit-software/os/installer:stable
KEYS_DIR       ?= $(BUILD)/keys
# The keys that sign the image, in KEYS_DIR: dev, or release, which are never
# generated by a build (make release-key; release/keys.md).
SIGNING_KEY    ?= dev
# What installed systems update from: the installer records it.
UPDATE_REF     ?= ghcr.io/shapebit-software/os:stable
# The local registry that `make publish` serves the image from, as
# DEV_UPDATE_REF, which a test machine reaches at the host's 10.0.2.2 (QEMU
# user networking); the update test switches the machine to it.
REGISTRY_PORT  ?= 5000
DEV_UPDATE_REF ?= 10.0.2.2:$(REGISTRY_PORT)/shapebit-os:dev
# The update test moves the installed machine to NEXT_ARCHIVE's build, then to
# NEXT2_ARCHIVE's, both newer, and back; `make update-builds` builds those of
# UPDATE_TAGS. Candidate installs stable instead, and passes the candidate as
# NEXT_ARCHIVE, so it builds only next2.
UPDATE_TAGS    ?= next next2
NEXT_ARCHIVE   ?= $(BUILD)/image-next.tar
NEXT2_ARCHIVE  ?= $(BUILD)/image-next2.tar
# The order of the openQA modules (tests/openqa/main.pm): install, everything
# from the medium; or update, which also updates the installed system to
# UPDATE_ARCHIVE's build before the desktop's modules.
FLOW           ?= install
UPDATE_ARCHIVE ?= $(IMAGE_ARCHIVE)
# What the image's checks need in its container, which has no pytest.
TEST_DEPS      ?= tests/image/.deps
# The source RPMs of the image, and of the installer
# (release/sources.py, release/README.md). SOURCES_PREVIOUS names an earlier
# version's sources to compare with; SOURCES_CACHE, a directory of source RPMs
# to take instead of downloading them. Both are optional.
SOURCES_DIR           ?= $(BUILD)/sources
INSTALLER_SOURCES_DIR ?= $(BUILD)/installer-sources
INSTALLER_SOURCES     ?= $(BUILD)/installer-sources.tar
SOURCES_PREVIOUS      ?=
SOURCES_CACHE         ?=
# The directory of the image's software bill of materials, in SPDX
# (release/sbom.py, release/README.md), and the syft that scans it, pinned by digest.
SBOM       ?= $(BUILD)/sbom
SYFT_IMAGE ?= docker.io/anchore/syft:v1.18.1@sha256:b8c170b8e51bfc4779ec3ef4399942c57290f5ce76a9c3af564c9d00d4946a6b

# External packages, which ShapeBit builds and publishes in its own repository
# (packages/repositories/README.md): the one that `make rpm` builds, where
# built packages go, where the published ones are (release assets, by tag),
# and the public key of the repository's signature.
RPM            ?= packages/dictation/sherpa-onnx
RPMS           ?= $(BUILD)/rpms
RPM_RELEASES   ?= https://github.com/shapebit-software/os/releases/download
RPM_PUBLIC_KEY ?= packages/repositories/third-party.asc
EXPORTS := SYFT_IMAGE RPM_RELEASES RPM_PUBLIC_KEY INSTALLER_REF IMAGE_REVISION IMAGE_ARCHIVE ENGINE IMAGE \
  FEDORA_VERSION IMAGE_VERSION BUILD INSTALLER_IMAGE MEDIUM MEDIUM_SIZE KEYS_DIR SIGNING_KEY REGISTRY_PORT \
  UPDATE_REF DEV_UPDATE_REF
export $(EXPORTS) DEV_IMAGE FOUNDATION FOUNDATION_CACHE
# The test settings that tests/machine.py reads, and IMAGE_DIGEST, for
# test-guest: they cross into the development image only when set, as in
# `make disk OWNER_NAME=someone`.
TEST_SETTINGS := DISK DISK_SIZE RESULTS SSH_KEY SSH_PORT TEST_SSH_PORT BOOT_TIMEOUT OWNER_NAME OWNER_PASSWORD \
  RECOVERY_KEY LOCALE KEYBOARD_LAYOUT TIME_ZONE IMAGE_DIGEST
# The scripts get the same settings in the development image (images/development/dev.sh).
export DEV_ENV := $(EXPORTS) $(TEST_SETTINGS)
# On the host, a command that needs the tools runs in the development image,
# which is built first; in the image, it runs as it is.
DEV_RUN := $(if $(IN_DEV_IMAGE),,images/development/dev.sh)
DEV_DEP := $(if $(IN_DEV_IMAGE),,dev-image)
# The checks of the built OS (tests/README.md), which run in the development image.
CHECKS := python3 -m pytest -c tests/pytest.ini -p no:cacheprovider

# Checks that run on this host leave no bytecode in the tree.
export PYTHONDONTWRITEBYTECODE := 1

.DEFAULT_GOAL := help
.PHONY: foundation dev dev-image run release-key help colors image static-checks lint validate test-unit test-image publish registry installer sbom rpm rpm-repo sources installer-sources pull-installer disk vm installer-vm ssh test test-installed update-builds test-update test-release test-guest clean

help: ## List targets
	@awk -F ':.*## ' '/^[a-z-]+:.*## / { printf "  %-12s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

KEYS := $(KEYS_DIR)/$(SIGNING_KEY)-secureboot.key $(KEYS_DIR)/$(SIGNING_KEY)-secureboot.crt \
        $(KEYS_DIR)/$(SIGNING_KEY)-pcr.key

# Candidate builds it with FOUNDATION_FRESH=1: from Fedora's latest, without a cache.
foundation: ## Build the foundation image, which the OS and the development image start from
	images/foundation/foundation.sh $(if $(FOUNDATION_FRESH),--fresh)

image: $(KEYS) foundation ## Build the container image with its signed UKI
	images/seal/seal.sh images/os/Containerfile $(IMAGE) $(IMAGE_ARCHIVE) \
	  --build-arg FOUNDATION=$(FOUNDATION) \
	  --build-arg BASE=$$($(ENGINE) image inspect --format '{{index .Config.Labels "software.shapebit.foundation.base"}}' $(FOUNDATION)) \
	  --build-arg IMAGE_VERSION=$(IMAGE_VERSION) \
	  --build-arg IMAGE_REVISION=$(IMAGE_REVISION) --build-arg SOURCE_DATE_EPOCH=$(SOURCE_DATE_EPOCH) \
	  --build-context packages=packages

colors: ## Write the QML module Colors's values from the system's colors (packages/colors/colors.toml)
	python3 packages/colors/colors.py

static-checks: lint validate ## Lint and validate, without building or running the code

dev-image: foundation ## Build the development image (images/development/Containerfile)
	$(ENGINE) build -t $(DEV_IMAGE) --build-arg FOUNDATION=$(FOUNDATION) \
	  --build-context packages=packages -f images/development/Containerfile images/development

ifndef IN_DEV_IMAGE
# On the host, these run in the development image.
dev: dev-image ## Open a shell in the development image
	images/development/dev.sh bash

lint validate test-unit: dev-image
	images/development/dev.sh $(MAKE) $@

run: dev-image ## Run the desktop in a window, inside the current Wayland session
	images/development/dev.sh --desktop $(MAKE) $@
else
# The desktop in a window, from this tree (images/development/README.md). Every
# feature is installed into DEV_SYSTEM, as the image installs it, for what
# reads installed files, such as Settings > Licenses and the portal's colors;
# so are the external packages that `make rpm` built, such as the assistant's
# model server. The host session's desktop name is not this one's; Hyprland
# sets its own. The extras are the person's own here, so Settings > Assistant
# downloads them without an administrator.
DEV        := $(abspath $(BUILD)/dev)
DEV_SYSTEM := $(DEV)/system
DEV_RPMS   := $(foreach rpm,$(wildcard $(RPMS)/*/*.x86_64.rpm),$(if $(findstring -debug,$(notdir $(rpm))),,$(rpm)))

run:
	rm -r -f $(DEV_SYSTEM)
	mkdir -p $(DEV)/extras
	for makefile in packages/*/Makefile; do \
	  $(MAKE) -C $$(dirname $$makefile) install DESTDIR=$(DEV_SYSTEM) IMAGE_VERSION=dev IMAGE_REVISION=dev FEDORA=dev || exit 1; \
	done
	for rpm in $(DEV_RPMS); do rpm2cpio $$rpm | (cd $(DEV_SYSTEM) && cpio -idm --quiet) || exit 1; done
	env -u XDG_CURRENT_DESKTOP DESKTOP_SHELL=$(CURDIR)/packages/shell QML_IMPORT_PATH=$(CURDIR)/packages/colors \
	  DEV_SYSTEM=$(DEV_SYSTEM) EXTRAS_DIR=$(DEV)/extras DICTATION_PARAKEET=$(DEV)/extras/parakeet \
	  LICENSES_DIR=$(DEV_SYSTEM)/usr/share/licenses images/development/run-desktop.sh

# Every shell and Python file of the repository, by its extension or its first
# line; a file with a #! line must be executable. openQA's modules are left out: their API comes from
# `from testapi import *`, so pyflakes cannot tell which of its names exist.
lint: ## Lint the shell, the Python, and the QML
	$(MAKE) -C packages/shell lint
	@status=0; python=; \
	for file in $$(git ls-files -co --exclude-standard); do \
	  [ -f "$$file" ] || continue; \
	  first=$$(head -c 100 "$$file" | head -n 1); \
	  case $$first in '#!'*) [ -x "$$file" ] || { echo "error: $$file has a #! line but is not executable" >&2; status=1; } ;; esac; \
	  case $$file:$$first in \
	    *.sh:* | *:'#!'*bash* | *:'#!'*/sh*) bash -n "$$file" || status=1 ;; \
	    *.py:* | *:'#!'*python*) grep -q '^from testapi import' "$$file" || python="$$python $$file" ;; \
	  esac; \
	done; \
	python3 -m pyflakes $$python || status=1; \
	exit $$status

# The external packages' License tags must be on Fedora's list of licenses
# (license-validate); ShapeBit's own license is not, so its packages are left out.
validate: ## Validate the compositor configuration, the specs' Requires, and the external packages' licenses
	$(MAKE) -C packages/windows validate
	packages/requires.sh --check
	@status=0; \
	for sources in $$(git ls-files 'packages/*/*/sources'); do \
	  spec=$$(dirname $$sources)/$$(basename $$(dirname $$sources)).spec; \
	  license-validate "$$(rpmspec -q --srpm --qf '%{LICENSE}' $$spec)" >/dev/null \
	    || { echo "error: $$spec: License is not on Fedora's list" >&2; status=1; }; \
	done; \
	exit $$status

# The unit tests, test_*.py, sit beside the code they test, in every folder;
# packages/test_install.py installs every feature. Then the installer's (CTest).
test-unit: ## Run the tests that need no image and no VM
	python3 -m pytest -ra --tb=short -v -p no:cacheprovider --rootdir=. $$(git ls-files -co --exclude-standard '*test_*.py')
	cmake -S packages/installer -B $(BUILD)/test-unit/installer -G Ninja
	cmake --build $(BUILD)/test-unit/installer
	ctest --test-dir $(BUILD)/test-unit/installer --output-on-failure
endif

# The image's checks run in its own container, with nothing installed in it.
test-image: image $(TEST_DEPS)/.done ## Build the image and test its files; nothing boots
	$(ENGINE) run --rm --network none -v "$(CURDIR)/tests:/tests:ro,z" \
	  -e PYTHONPATH=/tests/image/.deps -e PYTHONDONTWRITEBYTECODE=1 $(IMAGE) \
	  python3 -m pytest -c /tests/pytest.ini -p no:cacheprovider /tests/image

publish: image registry | $(DEV_DEP) ## Push the image to the local update registry
	$(DEV_RUN) tests/update/publish.sh $(IMAGE_ARCHIVE)

registry: ## Start the local update registry, unless it runs
	tests/update/registry.sh

# The payload's build context holds only the image: the engine copies a context
# whole, and BUILD also holds disks and other builds. A hard link costs no space.
installer: image ## Build the installer medium, which carries the image
	mkdir -p $(BUILD)/payload
	ln -f $(IMAGE_ARCHIVE) $(BUILD)/payload/image.tar 2>/dev/null || cp $(IMAGE_ARCHIVE) $(BUILD)/payload/image.tar
	images/seal/seal.sh images/installer/Containerfile $(INSTALLER_IMAGE) $(BUILD)/installer.tar \
	  --build-arg BASE=$(IMAGE) --build-arg UPDATE_REF=$(UPDATE_REF) --build-arg SOURCE_DATE_EPOCH=$(SOURCE_DATE_EPOCH) \
	  --build-context packages=packages --build-context payload=$(BUILD)/payload
	images/installer/medium.sh

sbom: image ## Write the image's software bill of materials, in SPDX, into SBOM
	release/sbom.py generate $(IMAGE) $(SBOM)

rpm: ## Build the external package RPM (a folder with a sources file), offline, into RPMS/NAME
	packages/repositories/rpm-build.sh $(RPM) $(RPMS)/$(notdir $(RPM))

rpm-repo: ## Write the signed repository of RPMS/releases (a directory per tag) into the Pages site RPMS/pages
	packages/repositories/rpm-repo.sh $(RPMS)/releases $(RPMS)/pages/rpms

sources: image ## Collect the image's source RPMs into SOURCES_DIR
	release/sources.py collect $(IMAGE) $(SOURCES_DIR) \
	  $(if $(SOURCES_CACHE),--cache $(SOURCES_CACHE)) $(if $(SOURCES_PREVIOUS),--previous $(SOURCES_PREVIOUS))

installer-sources: installer ## Write the installer's sources as INSTALLER_SOURCES, and record them with the medium
	release/sources.py collect $(INSTALLER_IMAGE) $(INSTALLER_SOURCES_DIR) $(if $(SOURCES_CACHE),--cache $(SOURCES_CACHE))
	release/sources.py tar $(INSTALLER_SOURCES_DIR) $(INSTALLER_SOURCES)
	python3 images/installer/provenance.py sources $(MEDIUM).json $(INSTALLER_SOURCES)

pull-installer: | $(DEV_DEP) ## Pull an installer medium from GHCR instead of building it: INSTALLER_REF=...
	$(DEV_RUN) images/installer/pull-installer.sh $(INSTALLER_REF)

# The machines and the checks run in the development image, with its QEMU and
# pytest (tests/machine.py); only the engine's work, such as building images,
# stays on the host.
disk: installer | $(DEV_DEP) ## Install to a new disk: boot the medium in QEMU, check it, and install
	$(DEV_RUN) python3 tests/machine.py install

vm: | $(DEV_DEP) ## Boot the installed disk in QEMU on this terminal (Ctrl-A X quits)
	$(DEV_RUN) python3 tests/machine.py boot

installer-vm: installer | $(DEV_DEP) ## Boot the medium with a new disk in a window, to install by hand
	$(DEV_RUN) $(if $(DEV_RUN),--desktop) python3 tests/machine.py install --window

ssh: | $(DEV_DEP) ## Open a root shell in the running machine
	$(DEV_RUN) python3 tests/machine.py ssh

test: test-image disk | $(DEV_DEP) ## Install, then check the installed system on a disposable clone of it
	$(DEV_RUN) $(CHECKS) tests/installed --machine=clone --run=installed

test-installed: | $(DEV_DEP) ## Check the installed system on a clone of the disk as it is, without installing
	$(DEV_RUN) $(CHECKS) tests/installed --machine=clone --run=installed

update-builds: $(KEYS) ## Build the newer images that the update test moves through (UPDATE_TAGS)
	set -e; for tag in $(UPDATE_TAGS); do \
	  $(MAKE) --no-print-directory image IMAGE="$${IMAGE%:*}:$$tag" \
	    IMAGE_VERSION=$(IMAGE_VERSION).$$tag IMAGE_ARCHIVE=$(BUILD)/image-$$tag.tar; \
	done

# On the next build, the installed system's checks run too, but for the
# reboots of check_persistence.py: the update test restarts it enough.
test-update: disk update-builds registry | $(DEV_DEP) ## On a disposable clone: update to a new build, then roll back
	$(DEV_RUN) tests/update/publish.sh $(NEXT_ARCHIVE) next
	$(DEV_RUN) tests/update/publish.sh $(NEXT2_ARCHIVE) next2
	$(DEV_RUN) $(CHECKS) tests/update/check_to_next.py tests/installed tests/update/check_rollback.py \
	  --ignore=tests/installed/check_persistence.py --machine=clone --run=update \
	  --next=$(NEXT_ARCHIVE) --next2=$(NEXT2_ARCHIVE)

test-release: | $(DEV_DEP) ## Full OS and UI tests of the built medium itself, with openQA (FLOW=install|update)
	DEV_NETWORK=private $(DEV_RUN) python3 tests/openqa/run.py $(FLOW) $(if $(filter update,$(FLOW)),$(UPDATE_ARCHIVE))

test-guest: | $(DEV_DEP) ## Check the system on another computer: GUEST=address IMAGE_DIGEST=sha256:... (tests/README.md)
	$(DEV_RUN) $(CHECKS) tests/installed --machine=ssh://$(GUEST) --run=$(GUEST)

release-key: | $(DEV_DEP) ## Generate the release keys once, in KEYS_DIR outside build/; store them safely
	$(DEV_RUN) release/keys.sh --release

clean: ## Remove build outputs
	rm -rf $(BUILD)

# What the image's checks need in its container.
$(TEST_DEPS)/.done: tests/image/requirements.txt | $(DEV_DEP)
	rm -rf $(TEST_DEPS)
	$(DEV_RUN) python3 -m pip install -q --target $(TEST_DEPS) -r tests/image/requirements.txt
	touch $@

# The signing keys.
$(KEYS) &: | $(DEV_DEP)
	$(DEV_RUN) release/keys.sh
