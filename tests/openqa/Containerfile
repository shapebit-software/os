# isotovideo, openQA's test engine, with what ShapeBit's test modules and machine
# need: Inline::Python runs the Python modules, swtpm is the machine's TPM, and
# skopeo turns the build that FLOW=update moves to into an OCI layout.
FROM registry.opensuse.org/devel/openqa/containers/isotovideo:qemu-kvm
RUN zypper -n in perl-Inline-Python swtpm skopeo && zypper clean
