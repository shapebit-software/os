# ShapeBit's own builds of what Fedora lacks (third-party/README.md): metadata on
# GitHub Pages, signed with the key at the path below; the RPMs are release assets.
# Shipped beside Fedora's repositories, so that the system records where its
# packages come from; the image build and scripts/release/sources.py use it.
# Off on installed systems, which never fetch from it: the image build and
# scripts/release/sources.py turn it on (--enablerepo).
# The metadata is small, so dnf checks it hourly rather than every 48 hours:
# a rebuilt package then reaches the next local image build.
[shapebit]
name=ShapeBit packages
enabled=0
baseurl=https://shapebit-software.github.io/os/rpms/fedora-$releasever-$basearch/
repo_gpgcheck=1
gpgcheck=0
gpgkey=file:///usr/share/pki/rpm-gpg/third-party.asc
metadata_expire=1h

[shapebit-source]
name=ShapeBit packages - Source
baseurl=https://shapebit-software.github.io/os/rpms/fedora-$releasever-source/
enabled=0
repo_gpgcheck=1
gpgcheck=0
gpgkey=file:///usr/share/pki/rpm-gpg/third-party.asc
metadata_expire=1h
