# check=skip=InvalidDefaultArgInFrom
# The installer medium: the ShapeBit system plus the installer and the system
# to install. It is built from the sealed system, BASE, and then sealed in the
# same way (see scripts/image.sh), which replaces BASE's UKI with one whose
# composefs digest also covers the payload. So the released os:<version> is
# both the payload and the base, and no unsealed image needs to be kept.
# Build contexts: `installer` is the installer source tree; `payload` is the
# directory with the sealed system archive, image.tar, which is BASE.
# BASE has no default: the Makefile always passes it.
ARG BASE
FROM ${BASE} AS build
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install cmake ninja-build gcc-c++ qt6-qtbase-devel qt6-qtdeclarative-devel libxkbcommon-devel
COPY --from=installer . /src
RUN cmake -S /src -B /build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/usr && \
    cmake --build /build && DESTDIR=/out cmake --install /build

FROM ${BASE}
# cage shows the installer full screen; nothing else of a desktop is needed.
# dnf's cache is a build cache, never in the image; the rest of its state in
# /var and /run is removed, since bootc ignores it on install.
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install cage qt6-qtbase-gui qt6-qtdeclarative qt6-qtwayland mesa-dri-drivers \
      google-noto-sans-fonts google-noto-sans-mono-fonts && \
    rm -rf /var/log/dnf5.log /var/lib/dnf /var/cache/ldconfig /run/dnf
COPY --from=build /out/ /
# The units are enabled by the preset that the installer ships, which also
# holds on the first boot, when systemd applies presets again. The installer
# takes the screen, so the system's login screen is masked; presets skip
# masked units.
RUN systemctl set-default graphical.target && \
    systemctl preset installer-backend.service installer.service && \
    systemctl mask sddm.service

# What the installer installs, and where the installed system updates from. An
# OCI layout, not the archive: bootc would unpack an archive into /var/tmp first,
# which the medium has no room for, and fs-verity misreads a file of about 4 GB.
# skopeo flattens Docker's nested index, which bootc cannot read in a layout.
RUN --mount=type=bind,from=payload,target=/payload \
    mkdir -p /usr/share/installer && \
    skopeo copy -q --preserve-digests oci-archive:/payload/image.tar oci:/usr/share/installer/image
# The installer's sources are published beside it, not with the system's.
LABEL software.shapebit.sources="https://download.shapebit.software/shapebit-installer-sources.tar"
ARG UPDATE_REF
RUN test -n "$UPDATE_REF" && \
    printf '[Payload]\nSource=oci:/usr/share/installer/image\nUpdateRef=%s\n' "$UPDATE_REF" \
      >/usr/share/installer/installer.conf
RUN bootc container lint
