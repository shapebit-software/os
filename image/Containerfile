# ShapeBit OS: bootc image, booted by systemd-boot from a signed UKI.
# This is the unsealed system; Containerfile.seal adds the UKI (see
# scripts/build/image.sh), and Containerfile.installer builds the installer medium
# from it. Signing needs the key as build secrets signing.key and signing.crt, and
# KEYS_ID, which changes with it.
# Only signed binaries and public keys reach the image.
ARG FEDORA_VERSION=45
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION} AS base

# ShapeBit's system and identity (build context `system-source`, system.spec): the
# packages system and release, at the image's version and commit. release
# stands in for Fedora's identity package at the version of the base image's
# fedora-release-common, which asks for one. The splash's links need Fedora's
# spinner theme. systemd-boot is signed here, with the certificate that the
# person enrolls; the key is a build secret, and only the signed binary and the
# certificate enter the package. KEYS_ID changes with the key.
FROM base AS system-packages
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install rpm-build plymouth-theme-spinner systemd-boot-unsigned sbsigntools openssl && \
    mkdir /out
ARG IMAGE_VERSION
ARG IMAGE_REVISION
ARG KEYS_ID
RUN --mount=type=bind,from=system-source,target=/src \
    --mount=type=secret,id=signing.key --mount=type=secret,id=signing.crt \
    mkdir /tmp/signed && \
    sbsign --key /run/secrets/signing.key --cert /run/secrets/signing.crt \
      --output /tmp/signed/systemd-bootx64.efi.signed /usr/lib/systemd/boot/efi/systemd-bootx64.efi && \
    openssl x509 -in /run/secrets/signing.crt -outform DER -out /tmp/signed/enroll-this-key.cer && \
    rpmbuild -bb --quiet --define "_topdir /tmp/rpm" --define "image_version $IMAGE_VERSION" \
      --define "image_revision $IMAGE_REVISION" --define "source_dir /src" --define "signed_dir /tmp/signed" \
      --define "fedora_release $(rpm -q --qf '%{VERSION}-%{RELEASE}' fedora-release-common)" \
      --define "systemd_boot $(rpm -q --qf '%{VERSION}-%{RELEASE}' systemd-boot-unsigned)" /src/system.spec && \
    cp /tmp/rpm/RPMS/noarch/*.rpm /out/

# What under /usr no RPM has as it is in the base image (scripts/build/packaged.py).
FROM base AS base-packaged
RUN --mount=type=bind,from=build-scripts,source=packaged.py,target=/run/packaged.py \
    mkdir /out && python3 /run/packaged.py list >/out/base

FROM base AS system

LABEL org.opencontainers.image.title="ShapeBit OS" \
      org.opencontainers.image.url="https://shapebit.software" \
      org.opencontainers.image.source="https://github.com/shapebit-software/os"

# What the system and the desktop run on: the Requires of system/system.spec
# and desktop/desktop.spec, each with the reason for it, in one transaction,
# without weak dependencies or Fedora's count of systems (as the system package
# sets for later). Only the specs are read, so this step runs again only when
# they change. Fedora has no Hyprland, so it comes from a third-party COPR for
# now (hyprland.repo); what else Fedora lacks, such as sherpa-onnx and llama-server, ShapeBit
# builds itself (third-party.repo, signed with the key of third-party.asc; third-party/README.md).
# The system package ships both beside Fedora's repositories; here they are
# mounted from its source, so this step does not wait for the package. dnf's cache is a
# build cache, kept between builds and never in the image. The rest of dnf's
# state in /var and /run is removed, since bootc ignores it on install; so are
# SDDM's runtime directory, which tmpfiles.d creates on each boot, and libX11's
# empty cache. Hyprland's own session entry is not installed, so the login
# screen offers only the desktop's, nor is UWSM's unit manager, which no person
# needs to see in Apps: rpm's %_netsharedpath skips them and records them as not
# installed, so the packages still verify (scripts/build/packaged.py). Fedora's Cisco repository is left out: Cisco pays
# the H.264 patent royalties only for the openh264 that people download from
# Cisco, so an image that carried it would redistribute it unlicensed;
# Fedora's noopenh264 stands in, and apps get H.264 from Flathub's extension,
# which downloads from Cisco.
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    --mount=type=bind,from=system-source,source=system.spec,target=/run/system.spec \
    --mount=type=bind,from=desktop,source=desktop.spec,target=/run/desktop.spec \
    --mount=type=bind,from=system-source,source=usr/share/dnf5/repos.d,target=/etc/yum.repos.d \
    --mount=type=bind,from=system-source,source=usr/share/pki/rpm-gpg,target=/usr/share/pki/rpm-gpg <<'EOF'
set -euo pipefail
echo '%_netsharedpath /usr/share/wayland-sessions/hyprland.desktop:/usr/share/applications/uuctl.desktop' \
  >/etc/rpm/macros.netshared
dnf -y install --disablerepo=fedora-cisco-openh264 --enablerepo=hyprland,shapebit --setopt=install_weak_deps=False --setopt='*.countme=0' \
  $(sed -n 's/^Requires: *//p' /run/system.spec /run/desktop.spec | grep -v '%{')
rm -rf /etc/rpm/macros.netshared /var/log/dnf5.log /var/lib/dnf /var/cache/ldconfig /run/dnf /run/sddm /var/cache/libX11
EOF

# ShapeBit's system and identity, which need nothing the image lacks; release
# replaces Fedora's identity package. They are built in this build, so they
# carry no signature.
RUN --mount=type=bind,from=system-packages,source=/out,target=/run/packages \
    dnf -y install --disablerepo='*' --nogpgcheck --allowerasing /run/packages/*.rpm && \
    rm -rf /var/log/dnf5.log /var/lib/dnf /var/cache/ldconfig /run/dnf

# The boot splash (Plymouth): ShapeBit's theme, system/usr/share/plymouth/
# themes/boot, with the spinner theme's images, is the default in the
# distribution defaults. The initramfs, rebuilt below, carries it.
RUN sed -i 's/^Theme=.*/Theme=boot/' /usr/share/plymouth/plymouthd.defaults && \
    test "$(plymouth-set-default-theme)" = boot

# os-update.timer checks for system updates (system/usr/lib/systemd/system).
# The base image's own timers are masked: rpm-ostree-countme reports to
# Fedora that this computer exists, and bootc-fetch-apply-updates installs
# updates and restarts by itself, which os-update does instead. Both now skip
# themselves, since they need /run/ostree-booted, which a composefs system
# lacks; masking keeps them off if that changes. bootc enables its timer in
# /usr, which a preset cannot undo.
RUN systemctl set-default graphical.target && systemctl preset os-update.timer && \
    systemctl mask rpm-ostree-countme.timer bootc-fetch-apply-updates.timer

# Logins for systemd-homed users need pam_systemd_home. authselect's checksum
# in /var is dropped, as in the base image; the configuration lives in /etc.
# authselect's stack ignores pam_systemd_home's other failures and lets
# pam_unix accept the password, so a home that cannot open, for lack of disk
# space say, still signs in to a session without one, which ends at once. The
# login screen asks pam_systemd_home first and stops on any failure; users that
# systemd-homed does not manage pass on to authselect's stack.
RUN authselect enable-feature with-systemd-homed && rm -r /var/lib/authselect && \
    sed -i '/^auth .*pam_selinux_permit\.so/a auth        [success=ok user_unknown=ignore default=die] pam_systemd_home.so' \
      /etc/pam.d/sddm && \
    grep -q '^auth .*default=die\] pam_systemd_home\.so' /etc/pam.d/sddm

# The initramfs must carry /usr/lib/composefs/setup-root-conf.toml and
# ShapeBit's os-release, so it is rebuilt after the system package is in place.
RUN kernel=$(basename /usr/lib/modules/*) && \
    dracut --force "/usr/lib/modules/$kernel/initramfs.img" "$kernel"

# Build tools, used by the stages below and never part of the final image:
# rpm-build and make build ShapeBit's own packages.
FROM system AS tools
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install rpm-build make && mkdir /out

# The desktop's package (build context `desktop`, desktop.spec), at the image's
# version: what its Makefile installs, so that the RPM database knows every file.
FROM tools AS desktop-package
ARG IMAGE_VERSION
RUN --mount=type=bind,from=desktop,target=/src \
    rpmbuild -bb --quiet --define "_topdir /tmp/rpm" --define "image_version $IMAGE_VERSION" \
      --define "source_dir /src" /src/desktop.spec && \
    cp /tmp/rpm/RPMS/noarch/*.rpm /out/

# The notices that some installed RPMs lack, from their exact source RPMs, as
# a package at the image's version (build context `license-notices`,
# license-notices.spec). Source RPMs stay in this stage's cache.
FROM tools AS licenses
ARG IMAGE_VERSION
RUN --mount=type=bind,from=license-notices,target=/src \
    --mount=type=cache,target=/var/cache/licenses,sharing=locked \
    rpmbuild -bb --quiet --define "_topdir /tmp/rpm" --define "image_version $IMAGE_VERSION" \
      --define "source_dir /src" --define "cache /var/cache/licenses" /src/license-notices.spec && \
    cp /tmp/rpm/RPMS/noarch/*.rpm /out/

FROM system
# ShapeBit's own packages need nothing that the image lacks, so rpm installs
# them without a repository. They are built in this build, so they carry no
# signature, which the base image's rpm otherwise asks for.
RUN --mount=type=bind,from=desktop-package,source=/out,target=/run/packages \
    --mount=type=bind,from=licenses,source=/out,target=/run/notices \
    rpm -i --nosignature /run/packages/*.rpm /run/notices/*.rpm
# The desktop's settings defaults (window-buttons.gschema.override) apply
# once the schemas are compiled again.
RUN glib-compile-schemas /usr/share/glib-2.0/schemas
# Identifies this build, the commit it is made from, and where its sources
# are published once it is released (docs/License.md), as os-release does
# from the release package.
ARG IMAGE_VERSION
ARG IMAGE_REVISION
LABEL org.opencontainers.image.version="$IMAGE_VERSION" \
      org.opencontainers.image.revision="$IMAGE_REVISION" \
      software.shapebit.sources="ghcr.io/shapebit-software/os:$IMAGE_VERSION-sources"
# Every file this build adds to /usr belongs to a package, as the package has
# it, so that its license, sources and SBOM entry come with it (scripts/build/packaged.py).
RUN --mount=type=bind,from=build-scripts,source=packaged.py,target=/run/packaged.py \
    --mount=type=bind,from=base-packaged,source=/out/base,target=/run/base \
    python3 /run/packaged.py check /run/base
RUN bootc container lint
