# ShapeBit OS: bootc image, booted by systemd-boot from a signed UKI.
# This is the unsealed system; Containerfile.seal adds the UKI (see
# scripts/image.sh), and Containerfile.installer builds the installer medium
# from it. Signing needs the key as build secrets signing.key and signing.crt, and
# KEYS_ID, which changes with it.
# Only signed binaries and public keys reach the image.
ARG FEDORA_VERSION=45
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION} AS system

LABEL org.opencontainers.image.title="ShapeBit OS" \
      org.opencontainers.image.url="https://shapebit.software" \
      org.opencontainers.image.source="https://github.com/shapebit-software/os"

# Files under rootfs/ are copied verbatim; their paths mirror the target system.
COPY rootfs/ /

# The system's packages (image/packages) and the desktop's (build context
# `desktop`, its file packages), each listed with the reason for it, in one
# transaction. Fedora has no Hyprland, so it comes from a third-party COPR for
# now (hyprland.repo, which scripts/sources.py also reads); the repository is
# mounted only for this build and is not left in the image. dnf's cache is a
# build cache, kept between builds and never in the image. The rest of dnf's
# state in /var and /run is removed, since bootc ignores it on install; so are
# SDDM's runtime directory, which tmpfiles.d creates on each boot, and libX11's
# empty cache. Hyprland's own session entries are removed, so the login screen
# offers only the desktop's. Fedora's Cisco repository is left out: Cisco pays
# the H.264 patent royalties only for the openh264 that people download from
# Cisco, so an image that carried it would redistribute it unlicensed;
# Fedora's noopenh264 stands in, and apps get H.264 from Flathub's extension,
# which downloads from Cisco.
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    --mount=type=bind,source=packages,target=/run/system-packages \
    --mount=type=bind,from=desktop,source=packages,target=/run/desktop-packages \
    --mount=type=bind,source=hyprland.repo,target=/etc/yum.repos.d/hyprland.repo <<'EOF'
set -euo pipefail
dnf -y install --disablerepo=fedora-cisco-openh264 $(sed 's/#.*//' /run/system-packages /run/desktop-packages)
rm -rf /var/log/dnf5.log /var/lib/dnf /var/cache/ldconfig /run/dnf /run/sddm /var/cache/libX11
rm /usr/share/wayland-sessions/hyprland.desktop
EOF

# The boot splash (Plymouth): ShapeBit's theme, rootfs/usr/share/plymouth/
# themes/boot, takes the spinner and the password prompt's images from
# Fedora's spinner theme, and is the default in the distribution defaults.
# The initramfs, rebuilt below, carries it.
RUN find /usr/share/plymouth/themes/spinner -name '*.png' ! -name watermark.png \
      -exec cp -t /usr/share/plymouth/themes/boot {} + && \
    sed -i 's/^Theme=.*/Theme=boot/' /usr/share/plymouth/plymouthd.defaults && \
    test "$(plymouth-set-default-theme)" = boot

# New Distrobox containers start from Fedora's toolbox image of this image's
# Fedora version, rather than its latest.
RUN mkdir -p /usr/share/distrobox && \
    echo "container_image_default=\"registry.fedoraproject.org/fedora-toolbox:$(rpm -E %fedora)\"" \
      >/usr/share/distrobox/distrobox.conf

# os-update.timer checks for system updates (rootfs/usr/lib/systemd/system).
# The base image's own timers are masked: rpm-ostree-countme reports to
# Fedora that this computer exists, and bootc-fetch-apply-updates installs
# updates and restarts by itself, which os-update does instead. Both now skip
# themselves, since they need /run/ostree-booted, which a composefs system
# lacks; masking keeps them off if that changes. bootc enables its timer in
# /usr, which a preset cannot undo.
RUN systemctl set-default graphical.target && systemctl preset os-update.timer && \
    systemctl mask rpm-ostree-countme.timer bootc-fetch-apply-updates.timer

# Logins for systemd-homed users need pam_systemd_home. authselect's checksum
# in /var is dropped, as in the base image; the configuration lives in /etc.
RUN authselect enable-feature with-systemd-homed && rm -r /var/lib/authselect

# The initramfs must carry /usr/lib/composefs/setup-root-conf.toml, so it is
# rebuilt after rootfs/ is in place.
RUN kernel=$(basename /usr/lib/modules/*) && \
    dracut --force "/usr/lib/modules/$kernel/initramfs.img" "$kernel"

# Build tools, used by the stages below and never part of the final image:
# sbsigntools signs; make installs the desktop's files; pip and patchelf fetch
# and fix sherpa-onnx; cmake, gcc-c++, make, and binutils build llama-server.
FROM system AS tools
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install sbsigntools make python3-pip patchelf cmake gcc-c++ binutils && mkdir /out

# systemd-boot, signed; bootctl installs the *.signed copy when present.
FROM tools AS bootloader
ARG KEYS_ID
RUN --mount=type=secret,id=signing.key --mount=type=secret,id=signing.crt \
    sbsign --key /run/secrets/signing.key --cert /run/secrets/signing.crt \
      --output /out/systemd-bootx64.efi.signed \
      /usr/lib/systemd/boot/efi/systemd-bootx64.efi

# The certificate that the person enrolls in shim's MOK manager (esp-shim).
FROM tools AS certificate
ARG KEYS_ID
RUN --mount=type=secret,id=signing.crt \
    openssl x509 -in /run/secrets/signing.crt -outform DER -out /out/enroll-this-key.cer

# The desktop's files (build context `desktop`), installed by its Makefile.
FROM tools AS desktop-files
RUN --mount=type=bind,from=desktop,target=/src make -C /src install DESTDIR=/out

# What the speech recognition of dictation runs on (desktop/dictation/
# dictate-engine): sherpa-onnx, which Fedora does not package. The wheels are checked
# against their hashes (desktop/dictation/requirements.txt), and pip stays here. Its
# models are too large for the image, and are downloaded (desktop/extras); so
# dictation works only once they are. The wheel bundles a copy of the ALSA
# library, under the LGPL, whose exact source is unknown; its module loads
# Fedora's instead (desktop/packages), whose source is the RPM's, and the copy
# is left out. The wheel carries no notices for the ONNX Runtime it bundles,
# so they come from desktop/dictation/licenses, with sherpa-onnx's own.
FROM tools AS sherpa
RUN --mount=type=bind,from=desktop,source=dictation/requirements.txt,target=/run/requirements.txt \
    --mount=type=bind,from=desktop,source=dictation/licenses,target=/run/licenses <<'EOF'
set -euo pipefail
dir=/out/usr/lib64/dictation
pip install --require-hashes --only-binary :all: --no-deps --target "$dir" -r /run/requirements.txt
bundled=$(basename "$dir"/sherpa_onnx.libs/libasound-*.so.2*)
patchelf --replace-needed "$bundled" libasound.so.2 "$dir"/sherpa_onnx/lib/_sherpa_onnx.cpython-*.so
rm -r "$dir/sherpa_onnx.libs"
install -Dm644 -t /out/usr/share/licenses/onnxruntime /run/licenses/onnxruntime/*
install -Dm644 "$dir"/sherpa_onnx-*.dist-info/licenses/LICENSE /out/usr/share/licenses/sherpa-onnx/LICENSE
EOF

# The assistant's language model server (desktop/assistant/llama-server@.service):
# llama.cpp's llama-server, which Fedora packages too old for Gemma 4. Its
# libraries stay beside it in /usr/libexec/llama; one build of the CPU code per
# kind of processor, chosen as it runs. No web page and no downloads: the model is an extra.
FROM tools AS llama
ARG LLAMA_VERSION
ARG LLAMA_SHA256
RUN <<'EOF'
set -euo pipefail
cd /tmp
curl -fsSL -o source.tar.gz "https://github.com/ggml-org/llama.cpp/archive/refs/tags/v$LLAMA_VERSION.tar.gz"
echo "$LLAMA_SHA256 source.tar.gz" | sha256sum -c
tar xzf source.tar.gz
cd "llama.cpp-$LLAMA_VERSION"
cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
  -DCMAKE_INSTALL_RPATH='$ORIGIN' -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
  -DGGML_NATIVE=OFF -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON -DGGML_BACKEND_DIR=/usr/libexec/llama \
  -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON -DLLAMA_BUILD_UI=OFF \
  -DLLAMA_USE_PREBUILT_UI=OFF -DLLAMA_OPENSSL=OFF
cmake --build build -j"$(nproc)" --target llama-server
strip build/bin/llama-server build/bin/*.so*
install -d /out/usr/libexec/llama
cp -a build/bin/llama-server build/bin/*.so* /out/usr/libexec/llama/
# Its license, and those of the code it vendors that ask for their notice.
install -Dm644 -t /out/usr/share/licenses/llama.cpp LICENSE licenses/LICENSE-*
install -Dm644 vendor/cpp-httplib/LICENSE /out/usr/share/licenses/llama.cpp/LICENSE-cpp-httplib
for hash in vendor/hash/*/LICENSE*; do
  install -Dm644 "$hash" "/out/usr/share/licenses/llama.cpp/LICENSE-$(basename "$(dirname "$hash")")"
done
EOF

FROM system
COPY --from=desktop-files /out/ /
COPY --from=sherpa /out/ /
COPY --from=llama /out/ /
# The desktop's settings defaults (window-buttons.gschema.override) apply
# once the schemas are compiled again.
RUN glib-compile-schemas /usr/share/glib-2.0/schemas
COPY --from=bootloader /out/ /usr/lib/systemd/boot/efi/
COPY --from=certificate /out/ /usr/share/secureboot/
# Identifies this build, the commit it is made from, and where its sources
# are published once it is released (docs/License.md); last, so a new version
# rebuilds only this layer.
ARG IMAGE_VERSION
ARG IMAGE_REVISION
LABEL org.opencontainers.image.version="$IMAGE_VERSION" \
      org.opencontainers.image.revision="$IMAGE_REVISION" \
      software.shapebit.sources="ghcr.io/shapebit-software/os:$IMAGE_VERSION-sources"
RUN test -n "$IMAGE_VERSION" && test -n "$IMAGE_REVISION" && \
    printf 'IMAGE_VERSION=%s\nIMAGE_REVISION=%s\n' "$IMAGE_VERSION" "$IMAGE_REVISION" >>/usr/lib/os-release
RUN bootc container lint
