# check=skip=InvalidDefaultArgInFrom
# The development image: the image's Fedora with every tool that works on
# ShapeBit (README.md): lint, validate, the unit tests, the desktop in a
# window, and the VMs and checks of the built OS. make builds it (dev-image)
# and runs those targets in it, for developers and CI alike; only the engine
# that builds the OS image stays on the host.
ARG FEDORA_VERSION
FROM registry.fedoraproject.org/fedora-toolbox:${FEDORA_VERSION}

# Fedora has no Hyprland: the COPR the image uses (packages/repositories/README.md#hyprland).
RUN dnf -y install dnf5-plugins && dnf -y copr enable sdegler/hyprland && dnf -y install \
    # Lint, validate (rpmspec, and Fedora's list of licenses), the unit tests,
    # and the external packages' RPMs that make run unpacks (rpm2cpio, cpio).
    git make python3 rpm-build license-validate cpio python3-pyflakes python3-pytest \
    # The checks of the built OS: the VMs (QEMU with Secure Boot firmware and
    # a software TPM, in a window for make installer-vm), SSH into them, tmt,
    # Testinfra, pip for the checks' own dependencies (distribution/checks/.deps),
    # skopeo for the update registry, and OpenSSL for the signing keys.
    qemu-system-x86-core qemu-device-display-virtio-vga qemu-img qemu-ui-gtk edk2-ovmf swtpm \
    openssh-clients tmt python3-pytest-testinfra python3-pip skopeo openssl \
    # The installer: Qt and its build tools.
    cmake ninja-build gcc-c++ qt6-qtbase-devel qt6-qtwayland qt6-qtdeclarative-devel libxkbcommon-devel \
    # The desktop: the compositor, the shell, idle time, and the monospaced font.
    hyprland hypridle quickshell mesa-dri-drivers jetbrains-mono-fonts xdg-user-dirs \
    # make run's own session bus, whose activation environment Hyprland sets
    # (dbus-tools), and the portals on it; the shell's portal backend is
    # Python with GObject. systemd-run reaches the host's user manager.
    dbus-daemon dbus-tools xdg-desktop-portal xdg-desktop-portal-hyprland python3-gobject systemd \
    # Applications to open in the desktop under development: a terminal, a
    # browser, and a file manager. Not Firefox, whose profile the host's may
    # use, nor Nautilus, which the host's GNOME owns on the host's session bus.
    foot epiphany Thunar \
    # Capture: the screen (grim, slurp, wf-recorder), the voice and the
    # camera, skipping silence (ffmpeg); clipman keeps copied text.
    grim slurp wf-recorder ffmpeg-free clipman \
    # Dictation (pw-record, wtype) and the assistant: spoken answers' phonemes
    # (espeak-ng), Smart Turn (ONNX Runtime), and the ChatGPT integration
    # tests' signed identities (PyJWT).
    pipewire-utils wtype espeak-ng python3-onnxruntime python3-jwt python3-cryptography \
    && dnf clean all

# isotovideo, openQA's test engine (distribution/openqa/), with Inline::Python
# for the Python modules. Weak dependencies are off: they bring QEMU for every
# architecture.
RUN dnf -y install --setopt=install_weak_deps=False os-autoinst perl-Inline-Python && dnf clean all

# The system's font (packages/font), which the shell draws with.
COPY --from=font InstrumentSans.ttf /usr/share/fonts/instrument-sans/
# The person's apps are the host's Flatpaks (flatpak).
COPY flatpak /usr/bin/flatpak
# The lock screen of make run unlocks with any password: the account here has
# none, and this image is never a computer's system.
RUN printf 'auth sufficient pam_permit.so\naccount sufficient pam_permit.so\n' >/etc/pam.d/login
# The account of editors' dev containers (.devcontainer), which they give the
# developer's user ID; development/dev.sh runs as the developer instead.
RUN useradd --create-home dev

# make runs the targets here as they are, rather than in this image again.
ENV IN_DEV_IMAGE=1
